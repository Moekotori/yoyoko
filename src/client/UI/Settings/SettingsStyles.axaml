<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector=".settingsRoot ScrollBar">
    <Setter Property="Margin" Value="0,8,2,8" />
  </Style>
  <Style Selector="TextBlock.settingsHeading">
    <Setter Property="FontSize" Value="14" /><Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Margin" Value="0,0,0,18" />
  </Style>
  <Style Selector="Border.settingsDivider"><Setter Property="Height" Value="1" /><Setter Property="Background" Value="{DynamicResource DividerBrush}" /><Setter Property="Margin" Value="0,32" /></Style>
  <Style Selector="Button.settingsNav">
    <Setter Property="Height" Value="38" /><Setter Property="Padding" Value="12,0" />
    <Setter Property="FontSize" Value="14" /><Setter Property="CornerRadius" Value="6" />
    <Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="NavSurface" Background="Transparent" CornerRadius="{TemplateBinding CornerRadius}">
          <Panel>
          <Border Name="NavMarker" Width="2" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{DynamicResource AccentBrush}" Opacity="0" />
          <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
            Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Stretch" />
          </Panel>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Button.settingsNav.selected"><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" /></Style>
  <Style Selector="Button.settingsNav:pointerover /template/ Border#NavSurface"><Setter Property="Background" Value="{DynamicResource HoverBrush}" /></Style>
  <Style Selector="Button.settingsNav.selected /template/ Border#NavMarker"><Setter Property="Opacity" Value="1" /></Style>
  <Style Selector="Button.settingsNav:focus-visible /template/ Border#NavSurface"><Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}" /><Setter Property="BorderThickness" Value="1" /></Style>
  <Style Selector="Button.settingsNav.selected PathIcon"><Setter Property="Opacity" Value="1" /></Style>
  <Style Selector="Button.settingsNav:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent" /></Style>
  <Style Selector="Button.settingsNav:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent" /></Style>
  <Style Selector="Button.settingsNav:focus-visible /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="BorderThickness" Value="0" /><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /></Style>
  <Style Selector="Border.settingsDrop">
    <Setter Property="Background" Value="{DynamicResource SidebarBrush}" /><Setter Property="CornerRadius" Value="6" />
    <Setter Property="BorderBrush" Value="Transparent" /><Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.settingsDrop.active"><Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}" /></Style>
  <Style Selector="Border.settingsGroup">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Border.settingsGroup.drop"><Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}" /><Setter Property="Background" Value="{DynamicResource SidebarBrush}" /></Style>
  <Style Selector="Border.settingsHit, Border.settingsPad">
    <Setter Property="MinHeight" Value="60" /><Setter Property="Padding" Value="0,12" />
    <Setter Property="Margin" Value="0" /><Setter Property="CornerRadius" Value="6" />
    <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.settingsHit"><Setter Property="Cursor" Value="Hand" /></Style>
  <Style Selector="Border.settingsHit:focus-visible"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Style>
  <Style Selector="Grid.settingsRow">
    <Setter Property="MinHeight" Value="60" /><Setter Property="Margin" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Border.settingsHit.recording"><Setter Property="Background" Value="{DynamicResource SubtleBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Style>
  <Style Selector="Border.shortcutCap">
    <Setter Property="MinWidth" Value="26" /><Setter Property="Height" Value="26" /><Setter Property="Padding" Value="7,0" />
    <Setter Property="Background" Value="{DynamicResource RaisedBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="4" />
    <Setter Property="HorizontalAlignment" Value="Center" /><Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.shortcutCap TextBlock"><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" /></Style>
  <Style Selector="Button.shortcutReset">
    <Setter Property="Width" Value="26" /><Setter Property="Height" Value="26" /><Setter Property="Padding" Value="6" />
    <Setter Property="VerticalAlignment" Value="Center" /><Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
  </Style>
  <Style Selector="Grid.settingsFact"><Setter Property="MinHeight" Value="52" /><Setter Property="Margin" Value="0" /></Style>
  <Style Selector="TextBlock.settingsLabel"><Setter Property="FontSize" Value="14" /><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
  <Style Selector="Border.settingsRowDivider"><Setter Property="Height" Value="1" /><Setter Property="Background" Value="{DynamicResource DividerBrush}" /><Setter Property="Margin" Value="0" /></Style>
  <Style Selector="ComboBox.settingsSelect">
    <Setter Property="HorizontalAlignment" Value="Right" /><Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Height" Value="34" /><Setter Property="MinHeight" Value="34" />
    <Setter Property="MinWidth" Value="240" /><Setter Property="Width" Value="240" /><Setter Property="MaxWidth" Value="240" />
    <Setter Property="Padding" Value="10,4,8,4" /><Setter Property="FontSize" Value="13" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="ComboBox.settingsSelect[IsDropDownOpen=true] /template/ Border#PopupBorder">
    <Setter Property="CornerRadius" Value="6" /><Setter Property="Padding" Value="4" />
  </Style>
  <Style Selector="ComboBox.settingsSelect ComboBoxItem">
    <Setter Property="MinHeight" Value="30" /><Setter Property="Padding" Value="8,4" /><Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="ToggleSwitch.settingsToggle">
    <Setter Property="MinWidth" Value="0" /><Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="KnobTransitions" Value="{x:Null}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="SwitchFocus" Padding="5" BorderThickness="1" BorderBrush="Transparent" CornerRadius="16" Background="Transparent">
          <Grid Width="42" Height="24">
            <Border Name="SwitchTrack" Background="{DynamicResource SwitchTrackBrush}" BorderBrush="{DynamicResource SwitchBorderBrush}" BorderThickness="1" CornerRadius="12" />
            <Canvas Name="PART_SwitchKnob" Width="18" Height="20" Margin="2" HorizontalAlignment="Left">
              <Grid Name="PART_MovingKnobs" Width="20" Height="20">
                <Border Name="SwitchThumb" Background="{DynamicResource SwitchThumbBrush}" CornerRadius="10"
                  RenderTransform="scale(1)" RenderTransformOrigin="50%,50%" />
              </Grid>
            </Canvas>
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ToggleSwitch.settingsToggle:checked /template/ Border#SwitchTrack"><Setter Property="Background" Value="{DynamicResource SwitchOnBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource SwitchOnBrush}" /></Style>
  <Style Selector="ToggleSwitch.settingsToggle:checked /template/ Border#SwitchThumb"><Setter Property="Background" Value="{DynamicResource SwitchOnThumbBrush}" /></Style>
  <Style Selector="ToggleSwitch.settingsToggle:pointerover /template/ Border#SwitchTrack"><Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}" /></Style>
  <Style Selector="ToggleSwitch.settingsToggle:checked:pointerover /template/ Border#SwitchTrack"><Setter Property="Background" Value="{DynamicResource SwitchOnHoverBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource SwitchOnHoverBrush}" /></Style>
  <Style Selector="ToggleSwitch.settingsToggle:pressed /template/ Border#SwitchThumb"><Setter Property="RenderTransform" Value="scale(0.9)" /></Style>
  <Style Selector="ToggleSwitch.settingsToggle:focus-visible /template/ Border#SwitchFocus"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Style>
  <Style Selector="ToggleSwitch.settingsToggle:disabled /template/ Border#SwitchFocus"><Setter Property="Opacity" Value="0.4" /></Style>
  <Style Selector="TextBox.settingsField">
    <Setter Property="Height" Value="36" /><Setter Property="Padding" Value="10,6" /><Setter Property="FontSize" Value="13" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="Background" Value="{DynamicResource FieldBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" /><Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="TextBox.settingsField:focus /template/ Border#PART_BorderElement"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter Property="Background" Value="{DynamicResource FieldFocusBrush}" /></Style>
  <Style Selector="Button.settingsSecondary">
    <Setter Property="HorizontalAlignment" Value="Left" /><Setter Property="Padding" Value="10,4" /><Setter Property="FontSize" Value="13" />
    <Setter Property="MinHeight" Value="34" /><Setter Property="Height" Value="34" /><Setter Property="CornerRadius" Value="6" />
    <Setter Property="Background" Value="{DynamicResource RaisedBrush}" /><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" /><Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Button.settingsPrimary">
    <Setter Property="HorizontalAlignment" Value="Right" /><Setter Property="MinWidth" Value="104" /><Setter Property="Height" Value="36" />
    <Setter Property="Padding" Value="16,8" /><Setter Property="FontWeight" Value="Medium" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="Button.settingsPrimary:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" /><Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" /></Style>
  <Style Selector="Button.settingsPrimary:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource AccentPressedBrush}" /><Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" /></Style>
  <Style Selector="Slider.settingsSlider">
    <Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Minimum" Value="0" /><Setter Property="Maximum" Value="100" />
    <Setter Property="Height" Value="28" /><Setter Property="IsSnapToTickEnabled" Value="True" />
    <Setter Property="TickFrequency" Value="1" /><Setter Property="SmallChange" Value="1" /><Setter Property="LargeChange" Value="10" />
  </Style>
  <Style Selector="Slider.settingsSlider /template/ RepeatButton#PART_DecreaseButton"><Setter Property="Background" Value="{DynamicResource AccentBrush}" /></Style>
  <Style Selector="Slider.settingsSlider /template/ RepeatButton#PART_IncreaseButton"><Setter Property="Background" Value="{DynamicResource SliderTrackBrush}" /></Style>
  <Style Selector="Slider.settingsSlider:pointerover /template/ RepeatButton#PART_DecreaseButton"><Setter Property="Background" Value="{DynamicResource SwitchOnHoverBrush}" /></Style>
  <Style Selector="Slider.settingsSlider /template/ Thumb#thumb"><Setter Property="Width" Value="16" /><Setter Property="Height" Value="16" /></Style>
  <Style Selector="Slider.settingsSlider:disabled"><Setter Property="Opacity" Value="0.4" /></Style>
  <Style Selector="TextBlock.settingsValue">
    <Setter Property="FontSize" Value="13" /><Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" /><Setter Property="MinWidth" Value="28" />
    <Setter Property="HorizontalAlignment" Value="Right" />
  </Style>
  <Style Selector="Border.shortcutHit"><Setter Property="MinHeight" Value="50" /><Setter Property="Padding" Value="0,8" /></Style>
  <Style Selector="Border.settingsHit:pointerover"><Setter Property="Background" Value="{DynamicResource MessageHoverBrush}" /></Style>
  <Style Selector="Border.settingsHit.recording"><Setter Property="Background" Value="{DynamicResource SubtleBrush}" /></Style>
</Styles>
