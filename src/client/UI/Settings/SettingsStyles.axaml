<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="TextBlock.settingsHeading">
    <Setter Property="FontSize" Value="15" /><Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Margin" Value="0,0,0,18" />
  </Style>
  <Style Selector="Border.settingsDivider"><Setter Property="Height" Value="1" /><Setter Property="Background" Value="{StaticResource DividerBrush}" /><Setter Property="Margin" Value="0,32" /></Style>
  <Style Selector="Button.settingsNav">
    <Setter Property="Height" Value="36" /><Setter Property="Padding" Value="12,0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="NavSurface" Background="Transparent" CornerRadius="2">
          <Grid>
            <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
              Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Left" />
            <Border Name="ActiveLine" Width="2" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center" Background="Transparent" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Button.settingsNav.selected"><Setter Property="Foreground" Value="#E7E1F0" /><Setter Property="FontWeight" Value="Medium" /></Style>
  <Style Selector="Button.settingsNav.selected /template/ Border#NavSurface"><Setter Property="Background" Value="#25232B" /></Style>
  <Style Selector="Button.settingsNav.selected /template/ Border#ActiveLine"><Setter Property="Background" Value="{StaticResource AccentBrush}" /></Style>
  <Style Selector="Button.settingsNav:pointerover /template/ Border#NavSurface"><Setter Property="Background" Value="#29272E" /></Style>
  <Style Selector="Button.settingsNav:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent" /></Style>
  <Style Selector="Button.settingsNav:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent" /></Style>
  <Style Selector="Button.settingsNav:focus-visible /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="BorderThickness" Value="0" /><Setter Property="Foreground" Value="{StaticResource AccentBrush}" /></Style>
  <Style Selector="Button.settingsNav:focus-visible /template/ Border#ActiveLine"><Setter Property="Background" Value="{StaticResource AccentBrush}" /></Style>
  <Style Selector="Button.settingsClose">
    <Setter Property="Width" Value="36" /><Setter Property="Height" Value="36" /><Setter Property="Padding" Value="9" />
    <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
  </Style>
  <Style Selector="Border.settingsPage.active.animated">
    <Style.Animations><Animation Duration="0:0:0.12" Easing="CubicEaseOut">
      <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /></KeyFrame>
      <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
    </Animation></Style.Animations>
  </Style>
  <Style Selector="Grid.settingsRow"><Setter Property="MinHeight" Value="72" /></Style>
  <Style Selector="TextBlock.settingsLabel"><Setter Property="FontSize" Value="14" /><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
  <Style Selector="Border.settingsRowDivider"><Setter Property="Height" Value="1" /><Setter Property="Background" Value="#28272C" /></Style>
  <Style Selector="ComboBox.settingsSelect">
    <Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Height" Value="36" /><Setter Property="MinHeight" Value="36" /><Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="12,6,4,6" /><Setter Property="Background" Value="#242328" />
    <Setter Property="BorderBrush" Value="#39363F" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="2" />
    <Setter Property="MaxDropDownHeight" Value="240" />
  </Style>
  <Style Selector="ComboBox.settingsSelect:pointerover /template/ Border#Background"><Setter Property="Background" Value="#2A282F" /><Setter Property="BorderBrush" Value="#56515F" /></Style>
  <Style Selector="ComboBox.settingsSelect:pressed /template/ Border#Background"><Setter Property="Background" Value="#2D2933" /><Setter Property="BorderBrush" Value="{StaticResource FocusBrush}" /></Style>
  <Style Selector="ComboBox.settingsSelect:focus-visible /template/ Border#HighlightBackground"><Setter Property="Background" Value="#242328" /><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" /></Style>
  <Style Selector="ComboBox.settingsSelect:focus-visible /template/ ContentControl#ContentPresenter"><Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" /></Style>
  <Style Selector="ComboBox.settingsSelect /template/ PathIcon#DropDownGlyph"><Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" /><Setter Property="Width" Value="10" /><Setter Property="Height" Value="10" /></Style>
  <Style Selector="ComboBox.settingsSelect /template/ Border#PopupBorder"><Setter Property="Background" Value="#242328" /><Setter Property="BorderBrush" Value="#45404D" /><Setter Property="CornerRadius" Value="2" /><Setter Property="Padding" Value="4" /></Style>
  <Style Selector="ComboBox.settingsSelect ComboBoxItem"><Setter Property="MinHeight" Value="34" /><Setter Property="Padding" Value="10,7" /><Setter Property="FontSize" Value="13" /><Setter Property="HorizontalContentAlignment" Value="Left" /></Style>
  <Style Selector="ComboBox.settingsSelect ComboBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#34303E" /><Setter Property="Foreground" Value="#E8DEF8" /></Style>
  <Style Selector="ComboBox.settingsSelect ComboBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#302C37" /></Style>
  <Style Selector="ToggleSwitch.settingsToggle">
    <Setter Property="MinWidth" Value="0" /><Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="KnobTransitions" Value="{x:Null}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="SwitchFocus" Padding="4" BorderThickness="1" BorderBrush="Transparent" CornerRadius="2">
          <Border Name="SwitchTrack" Width="36" Height="20" Background="#48454F" CornerRadius="10">
            <Canvas Name="PART_SwitchKnob" Width="16" Height="14" Margin="3" HorizontalAlignment="Left">
              <Grid Name="PART_MovingKnobs" Width="14" Height="14"><Ellipse Name="SwitchThumb" Fill="#C3BEC9" /></Grid>
            </Canvas>
          </Border>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ToggleSwitch.settingsToggle:checked /template/ Border#SwitchTrack"><Setter Property="Background" Value="{StaticResource AccentBrush}" /></Style>
  <Style Selector="ToggleSwitch.settingsToggle:checked /template/ Ellipse#SwitchThumb"><Setter Property="Fill" Value="#211C2C" /></Style>
  <Style Selector="ToggleSwitch.settingsToggle:pointerover /template/ Border#SwitchTrack"><Setter Property="Opacity" Value="0.85" /></Style>
  <Style Selector="ToggleSwitch.settingsToggle:focus-visible /template/ Border#SwitchFocus"><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" /></Style>
  <Style Selector="TextBox.settingsField">
    <Setter Property="Height" Value="44" /><Setter Property="Padding" Value="14,10" /><Setter Property="FontSize" Value="14" />
    <Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="Background" Value="#202023" />
    <Setter Property="BorderBrush" Value="#35333B" /><Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style Selector="TextBox.settingsField:focus /template/ Border#PART_BorderElement"><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" /><Setter Property="Background" Value="#25232A" /></Style>
  <Style Selector="Button.settingsSecondary">
    <Setter Property="HorizontalAlignment" Value="Left" /><Setter Property="Padding" Value="14,9" /><Setter Property="FontSize" Value="13" />
    <Setter Property="Background" Value="#29272E" /><Setter Property="Foreground" Value="#E4DFED" />
  </Style>
  <Style Selector="Button.settingsPrimary">
    <Setter Property="HorizontalAlignment" Value="Right" /><Setter Property="MinWidth" Value="104" /><Setter Property="Height" Value="38" />
    <Setter Property="Padding" Value="20,8" /><Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="Button.settingsPrimary:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#CAB9F2" /><Setter Property="Foreground" Value="#211C2C" /></Style>
  <Style Selector="Button.settingsPrimary:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#A590D5" /><Setter Property="Foreground" Value="#211C2C" /></Style>
</Styles>
