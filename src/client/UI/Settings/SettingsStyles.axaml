<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="TextBlock.settingsHeading">
    <Setter Property="FontSize" Value="15" /><Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Margin" Value="0,0,0,18" />
  </Style>
  <Style Selector="Border.settingsDivider"><Setter Property="Height" Value="1" /><Setter Property="Background" Value="{StaticResource DividerBrush}" /><Setter Property="Margin" Value="0,32" /></Style>
  <Style Selector="Button.settingsNav">
    <Setter Property="Height" Value="42" /><Setter Property="Padding" Value="14,0" />
    <Setter Property="FontSize" Value="14" /><Setter Property="CornerRadius" Value="2" />
    <Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="NavSurface" Background="#00363636" CornerRadius="{TemplateBinding CornerRadius}">
          <Grid>
            <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
              Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Left" />
            <Border Name="ActiveLine" CornerRadius="1" Width="2" Height="8" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{StaticResource AccentBrush}" Opacity="0" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Button.settingsNav.selected"><Setter Property="Foreground" Value="#E8E8E8" /><Setter Property="FontWeight" Value="Medium" /></Style>
  <Style Selector="Button.settingsNav.selected /template/ Border#NavSurface"><Setter Property="Background" Value="#383838" /></Style>
  <Style Selector="Button.settingsNav.selected /template/ Border#ActiveLine"><Setter Property="Height" Value="16" /><Setter Property="Opacity" Value="1" /></Style>
  <Style Selector="Button.settingsNav:pointerover /template/ Border#NavSurface"><Setter Property="Background" Value="#333333" /></Style>
  <Style Selector="Button.settingsNav.selected:pointerover /template/ Border#NavSurface"><Setter Property="Background" Value="#404040" /></Style>
  <Style Selector="Button.settingsNav:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent" /></Style>
  <Style Selector="Button.settingsNav:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent" /></Style>
  <Style Selector="Button.settingsNav:focus-visible /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="BorderThickness" Value="0" /><Setter Property="Foreground" Value="{StaticResource AccentBrush}" /></Style>
  <Style Selector="Button.settingsNav:focus-visible /template/ Border#ActiveLine"><Setter Property="Height" Value="16" /><Setter Property="Opacity" Value="1" /></Style>
  <Style Selector="Button.settingsClose">
    <Setter Property="Width" Value="32" /><Setter Property="Height" Value="32" /><Setter Property="Padding" Value="8" />
    <Setter Property="VerticalAlignment" Value="Center" /><Setter Property="CornerRadius" Value="2" />
    <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
    <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
  </Style>
  <Style Selector="Grid.settingsRow"><Setter Property="MinHeight" Value="84" /></Style>
  <Style Selector="TextBlock.settingsLabel"><Setter Property="FontSize" Value="15" /><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
  <Style Selector="Border.settingsRowDivider"><Setter Property="Height" Value="1" /><Setter Property="Background" Value="#2D2D2D" /></Style>
  <Style Selector="ComboBox.settingsSelect">
    <Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Height" Value="40" /><Setter Property="FontSize" Value="14" />
  </Style>
  <Style Selector="ToggleSwitch.settingsToggle">
    <Setter Property="MinWidth" Value="0" /><Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="KnobTransitions" Value="{x:Null}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="SwitchFocus" Padding="5" BorderThickness="1" BorderBrush="Transparent" CornerRadius="16" Background="Transparent">
          <Grid Width="42" Height="24">
            <Border Name="SwitchTrack" Background="#353535" BorderBrush="#505050" BorderThickness="1" CornerRadius="12" />
            <Canvas Name="PART_SwitchKnob" Width="18" Height="20" Margin="2" HorizontalAlignment="Left">
              <Grid Name="PART_MovingKnobs" Width="20" Height="20">
                <Border Name="SwitchThumb" Background="#D6D6D6" CornerRadius="10" BoxShadow="0 1 2 0 #40000000"
                  RenderTransform="scale(1)" RenderTransformOrigin="50%,50%" />
              </Grid>
            </Canvas>
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ToggleSwitch.settingsToggle:checked /template/ Border#SwitchTrack"><Setter Property="Background" Value="#D6D6D6" /><Setter Property="BorderBrush" Value="#D6D6D6" /></Style>
  <Style Selector="ToggleSwitch.settingsToggle:checked /template/ Border#SwitchThumb"><Setter Property="Background" Value="#262626" /></Style>
  <Style Selector="ToggleSwitch.settingsToggle:pointerover /template/ Border#SwitchTrack"><Setter Property="BorderBrush" Value="#888888" /></Style>
  <Style Selector="ToggleSwitch.settingsToggle:checked:pointerover /template/ Border#SwitchTrack"><Setter Property="Background" Value="#E8E8E8" /><Setter Property="BorderBrush" Value="#E8E8E8" /></Style>
  <Style Selector="ToggleSwitch.settingsToggle:pressed /template/ Border#SwitchThumb"><Setter Property="RenderTransform" Value="scale(0.9)" /></Style>
  <Style Selector="ToggleSwitch.settingsToggle:focus-visible /template/ Border#SwitchFocus"><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" /></Style>
  <Style Selector="ToggleSwitch.settingsToggle:disabled /template/ Border#SwitchFocus"><Setter Property="Opacity" Value="0.4" /></Style>
  <Style Selector="TextBox.settingsField">
    <Setter Property="Height" Value="44" /><Setter Property="Padding" Value="14,10" /><Setter Property="FontSize" Value="14" />
    <Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="Background" Value="#292929" />
    <Setter Property="BorderBrush" Value="#424242" /><Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="TextBox.settingsField:focus /template/ Border#PART_BorderElement"><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" /><Setter Property="Background" Value="#2B2B2B" /></Style>
  <Style Selector="Button.settingsSecondary">
    <Setter Property="HorizontalAlignment" Value="Left" /><Setter Property="Padding" Value="14,9" /><Setter Property="FontSize" Value="13" />
    <Setter Property="Background" Value="#333333" /><Setter Property="Foreground" Value="#DCDCDC" />
  </Style>
  <Style Selector="Button.settingsPrimary">
    <Setter Property="HorizontalAlignment" Value="Right" /><Setter Property="MinWidth" Value="104" /><Setter Property="Height" Value="38" />
    <Setter Property="Padding" Value="20,8" /><Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="Button.settingsPrimary:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#F0F0F0" /><Setter Property="Foreground" Value="#212121" /></Style>
  <Style Selector="Button.settingsPrimary:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#CCCCCC" /><Setter Property="Foreground" Value="#212121" /></Style>
</Styles>
