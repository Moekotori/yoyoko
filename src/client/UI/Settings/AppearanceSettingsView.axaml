<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:Chat.UI.Settings" xmlns:appearance="using:Chat.UI.Appearance" xmlns:i18n="using:Chat.UI.Localization"
  x:Class="Chat.UI.Settings.AppearanceSettingsView" x:DataType="vm:SettingsViewModel">
  <Border x:Name="Group" Classes="settingsGroup">
    <StackPanel>
      <Border Classes="settingsHit" Tapped="OnColorTapped">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
          <TextBlock Text="{i18n:T ColorScheme}" Classes="settingsLabel" />
          <ComboBox x:Name="ColorSchemeBox" Grid.Column="1" Classes="settingsSelect" ItemsSource="{Binding ColorSchemes}"
            SelectedItem="{Binding SelectedColorScheme}" AutomationProperties.Name="{i18n:T ColorScheme}">
            <ComboBox.ItemTemplate><DataTemplate x:DataType="appearance:ColorSchemeChoice"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
        </Grid>
      </Border>
      <Border Classes="settingsRowDivider" />
      <Border Classes="settingsHit" vm:SettingsHit.Command="{Binding ToggleCompact}"
        AutomationProperties.Name="{i18n:T CompactLayout}">
        <Grid ColumnDefinitions="*,240" ColumnSpacing="16">
          <TextBlock Text="{i18n:T CompactLayout}" Classes="settingsLabel" />
          <ToggleSwitch Grid.Column="1" Classes="settingsToggle" HorizontalAlignment="Right" Focusable="False"
            IsChecked="{Binding Compact}" />
        </Grid>
      </Border>
      <Border Classes="settingsRowDivider" />
      <Border Classes="settingsHit" vm:SettingsHit.Command="{Binding ToggleReduceMotion}"
        AutomationProperties.Name="{i18n:T ReduceMotion}">
        <Grid ColumnDefinitions="*,240" ColumnSpacing="16">
          <TextBlock Text="{i18n:T ReduceMotion}" Classes="settingsLabel" />
          <ToggleSwitch Grid.Column="1" Classes="settingsToggle" HorizontalAlignment="Right" Focusable="False"
            IsChecked="{Binding ReduceMotion}" />
        </Grid>
      </Border>
      <Border Classes="settingsRowDivider" />
      <Border Classes="settingsHit" vm:SettingsHit.Command="{Binding Wallpaper.Toggle}"
        AutomationProperties.Name="{i18n:T CustomBackground}">
        <Grid ColumnDefinitions="*,240" ColumnSpacing="16">
          <TextBlock Text="{i18n:T CustomBackground}" Classes="settingsLabel" />
          <ToggleSwitch Grid.Column="1" Classes="settingsToggle" HorizontalAlignment="Right" Focusable="False"
            IsChecked="{Binding Wallpaper.Enabled}" />
        </Grid>
      </Border>
      <Border Classes="settingsRowDivider" IsVisible="{Binding Wallpaper.Enabled}" />
      <Border Classes="settingsHit" IsVisible="{Binding Wallpaper.Enabled}" vm:SettingsHit.Command="{Binding Wallpaper.Choose}"
        AutomationProperties.Name="{i18n:T PickBackground}">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
          <TextBlock Text="{i18n:T PickBackground}" Classes="settingsLabel" />
          <DockPanel Grid.Column="1" LastChildFill="False" VerticalAlignment="Center">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Button Classes="settingsSecondary" Content="{i18n:T ChooseBackground}" IsHitTestVisible="False" Focusable="False" />
              <Button Classes="settingsSecondary" Content="{i18n:T RemoveBackground}" Command="{Binding Wallpaper.Clear}"
                IsVisible="{Binding Wallpaper.HasFile}" AutomationProperties.Name="{i18n:T RemoveBackground}" />
            </StackPanel>
            <TextBlock DockPanel.Dock="Left" Text="{Binding Wallpaper.FileLabel}" Classes="muted" FontSize="13"
              TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,12,0"
              IsVisible="{Binding Wallpaper.HasLabel}" />
          </DockPanel>
        </Grid>
      </Border>
      <Border Classes="settingsRowDivider" IsVisible="{Binding Wallpaper.CanAdjust}" />
      <Border Classes="settingsPad" IsVisible="{Binding Wallpaper.CanAdjust}">
        <Grid ColumnDefinitions="*,240" ColumnSpacing="16">
          <TextBlock Text="{i18n:T BackgroundBlur}" Classes="settingsLabel" />
          <Grid Grid.Column="1" ColumnDefinitions="32,*" ColumnSpacing="10">
            <TextBlock Text="{Binding Wallpaper.Blur, StringFormat={}{0:0}}" Classes="settingsValue" />
            <Slider Grid.Column="1" Classes="settingsSlider" Value="{Binding Wallpaper.Blur}"
              AutomationProperties.Name="{i18n:T BackgroundBlur}" />
          </Grid>
        </Grid>
      </Border>
      <Border Classes="settingsRowDivider" IsVisible="{Binding Wallpaper.CanAdjust}" />
      <Border Classes="settingsPad" IsVisible="{Binding Wallpaper.CanAdjust}">
        <Grid ColumnDefinitions="*,240" ColumnSpacing="16">
          <TextBlock Text="{i18n:T BackgroundBrightness}" Classes="settingsLabel" />
          <Grid Grid.Column="1" ColumnDefinitions="32,*" ColumnSpacing="10">
            <TextBlock Text="{Binding Wallpaper.Brightness, StringFormat={}{0:0}}" Classes="settingsValue" />
            <Slider Grid.Column="1" Classes="settingsSlider" Value="{Binding Wallpaper.Brightness}"
              AutomationProperties.Name="{i18n:T BackgroundBrightness}" />
          </Grid>
        </Grid>
      </Border>
      <TextBlock Text="{Binding Wallpaper.Error}" Classes="muted" FontSize="13" TextWrapping="Wrap"
        Margin="16,4,16,10" IsVisible="{Binding Wallpaper.HasError}" />
    </StackPanel>
  </Border>
</UserControl>
