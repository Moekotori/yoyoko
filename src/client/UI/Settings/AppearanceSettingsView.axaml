<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:Chat.UI.Settings" xmlns:i18n="using:Chat.UI.Localization"
  x:Class="Chat.UI.Settings.AppearanceSettingsView" x:DataType="vm:SettingsViewModel">
  <Border Classes="settingsGroup">
  <StackPanel>
    <Grid Classes="settingsRow" ColumnDefinitions="*,Auto" ColumnSpacing="20">
      <TextBlock Text="{i18n:T CompactLayout}" Classes="settingsLabel" />
      <ToggleSwitch Grid.Column="1" Classes="settingsToggle" IsChecked="{Binding Compact}" AutomationProperties.Name="{i18n:T CompactLayout}" />
    </Grid>
    <Grid Classes="settingsRow" ColumnDefinitions="*,Auto" ColumnSpacing="20">
      <TextBlock Text="{i18n:T ReduceMotion}" Classes="settingsLabel" />
      <ToggleSwitch Grid.Column="1" Classes="settingsToggle" IsChecked="{Binding ReduceMotion}" AutomationProperties.Name="{i18n:T ReduceMotion}" />
    </Grid>
  </StackPanel>
  </Border>
</UserControl>
