<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:Chat.UI.Settings" xmlns:appearance="using:Chat.UI.Appearance" xmlns:i18n="using:Chat.UI.Localization"
  x:Class="Chat.UI.Settings.AppearanceSettingsView" x:DataType="vm:SettingsViewModel">
  <Border Classes="settingsGroup">
    <StackPanel>
      <Grid Classes="settingsRow" ColumnDefinitions="2*,3*" ColumnSpacing="24">
        <TextBlock Text="{i18n:T ColorScheme}" Classes="settingsLabel" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
          <ComboBox Classes="settingsSelect" ItemsSource="{Binding ColorSchemes}"
            SelectedItem="{Binding SelectedColorScheme}" AutomationProperties.Name="{i18n:T ColorScheme}">
            <ComboBox.ItemTemplate><DataTemplate x:DataType="appearance:ColorSchemeChoice"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Text="{i18n:T NotImplemented}" Classes="muted" FontSize="13" IsVisible="{Binding ShowLightPlaceholder}" />
        </StackPanel>
      </Grid>
      <Border Classes="settingsRowDivider" />
      <Grid Classes="settingsRow" ColumnDefinitions="2*,3*" ColumnSpacing="24">
        <TextBlock Text="{i18n:T CompactLayout}" Classes="settingsLabel" />
        <ToggleSwitch Grid.Column="1" Classes="settingsToggle" HorizontalAlignment="Right"
          IsChecked="{Binding Compact}" AutomationProperties.Name="{i18n:T CompactLayout}" />
      </Grid>
      <Border Classes="settingsRowDivider" />
      <Grid Classes="settingsRow" ColumnDefinitions="2*,3*" ColumnSpacing="24">
        <TextBlock Text="{i18n:T ReduceMotion}" Classes="settingsLabel" />
        <ToggleSwitch Grid.Column="1" Classes="settingsToggle" HorizontalAlignment="Right"
          IsChecked="{Binding ReduceMotion}" AutomationProperties.Name="{i18n:T ReduceMotion}" />
      </Grid>
      <Border Classes="settingsRowDivider" />
      <Grid Classes="settingsRow" ColumnDefinitions="2*,3*" ColumnSpacing="24">
        <TextBlock Text="{i18n:T CustomBackground}" Classes="settingsLabel" />
        <ToggleSwitch Grid.Column="1" Classes="settingsToggle" HorizontalAlignment="Right"
          IsChecked="{Binding Wallpaper.Enabled}" AutomationProperties.Name="{i18n:T CustomBackground}" />
      </Grid>
      <Border Classes="settingsRowDivider" IsVisible="{Binding Wallpaper.Enabled}" />
      <Grid Classes="settingsRow" ColumnDefinitions="2*,3*" ColumnSpacing="24" IsVisible="{Binding Wallpaper.Enabled}">
        <TextBlock Text="{i18n:T PickBackground}" Classes="settingsLabel" />
        <DockPanel Grid.Column="1" LastChildFill="False" VerticalAlignment="Center">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button Classes="settingsSecondary" Content="{i18n:T ChooseBackground}" Command="{Binding Wallpaper.Choose}"
              AutomationProperties.Name="{i18n:T ChooseBackground}" />
            <Button Classes="settingsSecondary" Content="{i18n:T RemoveBackground}" Command="{Binding Wallpaper.Clear}"
              IsVisible="{Binding Wallpaper.HasFile}" AutomationProperties.Name="{i18n:T RemoveBackground}" />
          </StackPanel>
          <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,12,0">
            <TextBlock Text="{Binding Wallpaper.FileLabel}" Classes="muted" FontSize="13" TextTrimming="CharacterEllipsis"
              IsVisible="{Binding Wallpaper.HasLabel}" />
            <TextBlock Text="{Binding Wallpaper.Error}" Classes="muted" FontSize="13" TextWrapping="Wrap"
              IsVisible="{Binding Wallpaper.HasError}" />
          </StackPanel>
        </DockPanel>
      </Grid>
      <Border Classes="settingsRowDivider" IsVisible="{Binding Wallpaper.CanAdjust}" />
      <Grid Classes="settingsRow" ColumnDefinitions="2*,3*" ColumnSpacing="24" IsVisible="{Binding Wallpaper.CanAdjust}">
        <TextBlock Text="{i18n:T BackgroundBlur}" Classes="settingsLabel" />
        <Slider Grid.Column="1" Classes="settingsSlider" Minimum="0" Maximum="100" Value="{Binding Wallpaper.Blur}"
          AutomationProperties.Name="{i18n:T BackgroundBlur}" />
      </Grid>
      <Border Classes="settingsRowDivider" IsVisible="{Binding Wallpaper.CanAdjust}" />
      <Grid Classes="settingsRow" ColumnDefinitions="2*,3*" ColumnSpacing="24" IsVisible="{Binding Wallpaper.CanAdjust}">
        <TextBlock Text="{i18n:T BackgroundBrightness}" Classes="settingsLabel" />
        <Slider Grid.Column="1" Classes="settingsSlider" Minimum="0" Maximum="100" Value="{Binding Wallpaper.Brightness}"
          AutomationProperties.Name="{i18n:T BackgroundBrightness}" />
      </Grid>
    </StackPanel>
  </Border>
</UserControl>
