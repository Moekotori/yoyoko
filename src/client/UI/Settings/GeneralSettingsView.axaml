<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:Chat.UI.Settings" xmlns:i18n="using:Chat.UI.Localization"
  x:Class="Chat.UI.Settings.GeneralSettingsView" x:DataType="vm:SettingsViewModel">
  <Border Classes="settingsGroup">
  <StackPanel HorizontalAlignment="Stretch">
    <Border Classes="settingsPad">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
        <TextBlock Text="{i18n:T Language}" Classes="settingsLabel" />
        <ComboBox Grid.Column="1" Classes="settingsSelect" ItemsSource="{Binding Languages}"
          SelectedItem="{Binding SelectedLanguage}" AutomationProperties.Name="{i18n:T Language}">
          <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:LanguageOption"><TextBlock Text="{Binding NativeName}" /></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>
      </Grid>
    </Border>
    <Border Classes="settingsRowDivider" />
    <StackPanel Margin="0,28,0,28" Spacing="12">
      <TextBlock Text="{i18n:T LanguagePacks}" Classes="settingsLabel" FontWeight="Medium" />
      <Border Classes="settingsDrop" Classes.active="{Binding LanguagePackDropActive}" Padding="16" ToolTip.Tip="{i18n:T LanguagePackHelp}">
        <StackPanel Spacing="8">
          <TextBlock Text="{i18n:T DropLanguagePack}" FontSize="14" />
          <TextBlock Text="{i18n:T CustomLanguagePack}" Classes="muted" FontSize="13" IsVisible="{Binding CanRemoveLanguagePack}" />
          <TextBlock Text="{Binding LanguagePackNotice}" Classes="muted" FontSize="13" TextWrapping="Wrap" IsVisible="{Binding HasLanguagePackNotice}" />
          <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8">
            <Button Classes="settingsSecondary" Content="{i18n:T ExportLanguageTemplate}" Command="{Binding ExportLanguageTemplate}"
              AutomationProperties.Name="{i18n:T ExportLanguageTemplate}" />
            <Button Classes="settingsSecondary" Content="{i18n:T ImportLanguagePack}" Command="{Binding ImportLanguagePack}"
              AutomationProperties.Name="{i18n:T ImportLanguagePack}" />
            <Button Classes="settingsSecondary" Content="{i18n:T RemoveLanguagePack}" Command="{Binding RemoveLanguagePack}"
              IsVisible="{Binding CanRemoveLanguagePack}" AutomationProperties.Name="{i18n:T RemoveLanguagePack}" />
          </WrapPanel>
        </StackPanel>
      </Border>
    </StackPanel>
    <Border Classes="settingsRowDivider" />
    <Border Classes="settingsHit" vm:SettingsHit.Command="{Binding ToggleUltraLight}"
      ToolTip.Tip="{i18n:T UltraLightHelp}" AutomationProperties.Name="{i18n:T UltraLightMode}">
      <Grid ColumnDefinitions="*,240" ColumnSpacing="16">
        <TextBlock Text="{i18n:T UltraLightMode}" Classes="settingsLabel" />
        <ToggleSwitch Grid.Column="1" Classes="settingsToggle" Focusable="False" HorizontalAlignment="Right" IsChecked="{Binding UltraLightEnabled}" />
      </Grid>
    </Border>
  </StackPanel>
  </Border>
</UserControl>
