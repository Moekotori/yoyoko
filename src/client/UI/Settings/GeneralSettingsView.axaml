<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:Chat.UI.Settings" xmlns:i18n="using:Chat.UI.Localization"
  x:Class="Chat.UI.Settings.GeneralSettingsView" x:DataType="vm:SettingsViewModel">
  <Border Classes="settingsGroup">
  <StackPanel>
    <Grid Classes="settingsRow" ColumnDefinitions="*,280" ColumnSpacing="24">
      <TextBlock Text="{i18n:T Language}" Classes="settingsLabel" />
      <ComboBox Grid.Column="1" Classes="settingsSelect" ItemsSource="{Binding Languages}"
        SelectedItem="{Binding SelectedLanguage}" AutomationProperties.Name="{i18n:T Language}">
        <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:LanguageOption"><TextBlock Text="{Binding NativeName}" /></DataTemplate></ComboBox.ItemTemplate>
      </ComboBox>
    </Grid>
    <Grid Classes="settingsRow" ColumnDefinitions="*,280" ColumnSpacing="24">
      <TextBlock Text="{i18n:T SendShortcut}" Classes="settingsLabel" />
      <ComboBox Grid.Column="1" Classes="settingsSelect" ItemsSource="{Binding SendShortcutChoices}"
        SelectedIndex="{Binding SendMode}" AutomationProperties.Name="{i18n:T SendShortcut}" />
    </Grid>
  </StackPanel>
  </Border>
</UserControl>
