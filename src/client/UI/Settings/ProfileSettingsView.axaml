<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:Chat.UI.Settings" xmlns:i18n="using:Chat.UI.Localization" xmlns:c="using:Chat.UI.Components"
  x:Class="Chat.UI.Settings.ProfileSettingsView" x:DataType="vm:SettingsViewModel">
  <UserControl.Styles><StyleInclude Source="avares://Chat.UI/Settings/ProfileStyles.axaml" /></UserControl.Styles>
  <Border Classes="settingsGroup">
    <StackPanel IsEnabled="{Binding Profile.IsSignedIn}">
      <Border Classes="bannerPreview" ClipToBounds="True">
        <Panel>
          <c:Banner Height="120" Fallback="{Binding Profile.Accent}" Playback="{Binding Profile.BannerPlayback}" />
          <Button Classes="bannerPick" Height="120" Command="{Binding Profile.ChangeBanner}"
            ToolTip.Tip="{i18n:T ChangeBanner}" AutomationProperties.Name="{i18n:T ChangeBanner}">
            <Border Classes="bannerScrim">
              <PathIcon Data="{StaticResource IconCamera}" Width="20" Height="20" Foreground="#F2F2F2"
                HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </Button>
        </Panel>
      </Border>
      <Grid Classes="profileHero" ColumnDefinitions="Auto,*" ColumnSpacing="20">
        <Border Classes="avatarRing">
          <Button Classes="avatarPick" Width="88" Height="88" Command="{Binding Profile.ChangeAvatar}"
            ToolTip.Tip="{i18n:T ChangeAvatar}" AutomationProperties.Name="{i18n:T ChangeAvatar}">
            <Panel>
              <c:Avatar Width="88" Height="88" Playback="{Binding Profile.Playback}" Initial="{Binding Profile.Initial}" />
              <Border Classes="avatarScrim" IsHitTestVisible="False">
                <PathIcon Data="{StaticResource IconCamera}" Width="20" Height="20" Foreground="#F2F2F2"
                  HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </Panel>
          </Button>
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
          <TextBlock Text="{Binding Profile.PreviewName}" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding Profile.Handle}" Classes="muted" FontSize="13" IsVisible="{Binding Profile.HasHandle}" />
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
            <Button Classes="settingsSecondary profileAction" Content="{i18n:T ChangeAvatar}" Command="{Binding Profile.ChangeAvatar}" />
            <Button Classes="settingsSecondary profileAction" Content="{i18n:T RemoveAvatar}" Command="{Binding Profile.RemoveAvatar}"
              IsVisible="{Binding Profile.HasAvatar}" />
            <Button Classes="settingsSecondary profileAction" Content="{i18n:T ChangeBanner}" Command="{Binding Profile.ChangeBanner}" />
            <Button Classes="settingsSecondary profileAction" Content="{i18n:T RemoveBanner}" Command="{Binding Profile.RemoveBanner}"
              IsVisible="{Binding Profile.HasBanner}" />
          </StackPanel>
        </StackPanel>
      </Grid>
      <Border Classes="settingsRowDivider" />
      <Grid Classes="settingsRow" ColumnDefinitions="*,240" ColumnSpacing="16">
        <TextBlock Text="{i18n:T DisplayNameField}" Classes="settingsLabel" />
        <TextBox Grid.Column="1" Classes="settingsField profileField" Text="{Binding Profile.DisplayName}"
          MaxLength="100" PlaceholderText="{i18n:T DisplayNameField}" AutomationProperties.Name="{i18n:T DisplayNameField}" />
      </Grid>
      <Border Classes="settingsRowDivider" />
      <Grid Classes="settingsRow" ColumnDefinitions="*,240" ColumnSpacing="16">
        <TextBlock Text="{i18n:T Username}" Classes="settingsLabel" />
        <TextBox Grid.Column="1" Classes="settingsField profileField" Text="{Binding Profile.Username}"
          MaxLength="64" PlaceholderText="{i18n:T Username}" AutomationProperties.Name="{i18n:T Username}" />
      </Grid>
      <Grid Classes="profileFooter" ColumnDefinitions="*,Auto" ColumnSpacing="16">
        <TextBlock Text="{Binding Profile.Status}" Classes="muted" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" IsVisible="{Binding Profile.HasStatus}" />
        <Button Grid.Column="1" Classes="primary settingsPrimary profileSave" Content="{i18n:T SaveProfile}"
          Command="{Binding Profile.Save}" IsEnabled="{Binding Profile.IsSignedIn}" />
      </Grid>
    </StackPanel>
  </Border>
</UserControl>
