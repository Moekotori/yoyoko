<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:Chat.UI.Settings" xmlns:i18n="using:Chat.UI.Localization" xmlns:c="using:Chat.UI.Components"
  x:Class="Chat.UI.Settings.ProfileSettingsView" x:DataType="vm:SettingsViewModel">
  <StackPanel>
    <TextBlock Text="{i18n:T Profile}" Classes="settingsTitle" />
    <StackPanel IsVisible="{Binding !Profile.IsSignedIn}" Spacing="20">
      <TextBlock Text="{i18n:T NeedSignIn}" Classes="muted" TextWrapping="Wrap" />
      <Button Classes="primary settingsPrimary" Content="{i18n:T SignIn}" Command="{Binding Close}" />
    </StackPanel>
    <StackPanel IsVisible="{Binding Profile.IsSignedIn}">
      <Grid ColumnDefinitions="72,*" ColumnSpacing="20" Margin="0,0,0,28">
        <Grid Width="72" Height="72">
          <c:Avatar Playback="{Binding Profile.Playback}" />
          <PathIcon Data="{StaticResource IconPeople}" Width="26" Height="26" Foreground="{StaticResource MutedTextBrush}"
            IsVisible="{Binding !Profile.HasAvatar}" />
        </Grid>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
          <Button Classes="settingsSecondary" Content="{i18n:T ChangeAvatar}" Command="{Binding Profile.ChangeAvatar}" />
          <Button Content="{i18n:T RemoveAvatar}" Command="{Binding Profile.RemoveAvatar}" HorizontalAlignment="Left"
            Foreground="{StaticResource MutedTextBrush}" IsVisible="{Binding Profile.HasAvatar}" />
        </StackPanel>
      </Grid>
      <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,0,0,26" />
      <StackPanel Spacing="8" Margin="0,0,0,20">
        <TextBlock Text="{i18n:T Username}" FontSize="13" />
        <TextBox Classes="settingsField" Text="{Binding Profile.Username}" AutomationProperties.Name="{i18n:T Username}" />
      </StackPanel>
      <StackPanel Spacing="8">
        <TextBlock Text="{i18n:T DisplayNameField}" FontSize="13" />
        <TextBox Classes="settingsField" Text="{Binding Profile.DisplayName}" AutomationProperties.Name="{i18n:T DisplayNameField}" />
      </StackPanel>
      <Button Classes="primary settingsPrimary" Content="{i18n:T SaveProfile}" Command="{Binding Profile.Save}" Margin="0,28,0,0" />
      <TextBlock Text="{Binding Profile.Status}" Classes="muted" FontSize="13" TextWrapping="Wrap" Margin="0,14,0,0" IsVisible="{Binding Profile.HasStatus}" />
    </StackPanel>
  </StackPanel>
</UserControl>
