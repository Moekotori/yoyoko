<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:Chat.UI.Shell" xmlns:ch="using:Chat.UI.Channels"
  x:Class="Chat.UI.Channels.ChannelSidebar" x:DataType="vm:ShellViewModel">
  <Grid RowDefinitions="Auto,*,Auto" Background="{StaticResource SidebarBrush}">
    <StackPanel Margin="22,23,16,0" Spacing="8">
      <TextBlock Text="{Binding InstanceName}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
      <TextBlock Text="{Binding InstanceHost}" Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis" />
      <TextBlock Text="频道" Classes="muted" FontSize="12" Margin="0,28,0,0" IsVisible="{Binding IsSignedIn}" />
    </StackPanel>
    <ListBox Grid.Row="1" ItemsSource="{Binding Channels}" SelectedItem="{Binding SelectedChannel}"
      Margin="12,16" AutomationProperties.Name="频道列表" IsVisible="{Binding IsSignedIn}">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="ch:ChannelItem">
          <TextBlock Text="{Binding Label}" Margin="4,6" TextTrimming="CharacterEllipsis" />
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <StackPanel Grid.Row="2" Margin="18,8,18,16" Spacing="8" IsVisible="{Binding IsSignedIn}">
      <TextBlock Text="{Binding AccountName}" FontSize="13" TextTrimming="CharacterEllipsis" />
      <TextBlock Text="{Binding InviteHint}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
      <TextBox Text="{Binding CommunityName}" PlaceholderText="新社区名称" />
      <Button Content="创建社区" Command="{Binding CreateServer}" HorizontalAlignment="Stretch" />
      <TextBox Text="{Binding InviteInput}" PlaceholderText="邀请码" />
      <Button Content="加入社区" Command="{Binding JoinServer}" HorizontalAlignment="Stretch" />
      <Button Content="退出账号" Command="{Binding SignOut}" HorizontalAlignment="Stretch" />
    </StackPanel>
    <TextBlock Grid.Row="2" Text="未登录" Classes="muted" Margin="22,20" IsVisible="{Binding ShowGuest}" />
  </Grid>
</UserControl>
