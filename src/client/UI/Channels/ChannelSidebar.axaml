<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Chat.UI.Shell" xmlns:ch="using:Chat.UI.Channels" xmlns:chat="using:Chat.UI.Chat" xmlns:c="using:Chat.UI.Components" xmlns:i18n="using:Chat.UI.Localization"
 xmlns:motion="clr-namespace:Chat.Motion;assembly=Chat.Motion"
 x:Class="Chat.UI.Channels.ChannelSidebar" x:DataType="vm:ShellViewModel" x:Name="Sidebar">
  <UserControl.Styles>
    <Style Selector="Button.groupHeader"><Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="HorizontalContentAlignment" Value="Left" /><Setter Property="Height" Value="30" /><Setter Property="Padding" Value="8,0" /><Setter Property="CornerRadius" Value="2" /><Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" /></Style>
    <Style Selector="Button.groupAdd"><Setter Property="Width" Value="26" /><Setter Property="Height" Value="26" /><Setter Property="Padding" Value="7" /><Setter Property="CornerRadius" Value="2" /><Setter Property="Foreground" Value="{DynamicResource QuietTextBrush}" /></Style>
    <Style Selector="Button.channel"><Setter Property="CornerRadius" Value="2" /><Setter Property="Height" Value="32" /><Setter Property="Padding" Value="10,0" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style>
    <Style Selector="Button.channel.selected"><Setter Property="Background" Value="Transparent" /></Style>
    <Style Selector="Button.channel:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent" /></Style>
    <Style Selector="Button.channel.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent" /></Style>
    <Style Selector="Button.channel.selected PathIcon"><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" /></Style>
    <Style Selector="Button.channel.selected TextBlock"><Setter Property="FontWeight" Value="Medium" /><Setter Property="Foreground" Value="{DynamicResource StrongTextBrush}" /></Style>
    <Style Selector="Button.channel.connected PathIcon"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /></Style>
    <Style Selector="Button.channel.connected TextBlock"><Setter Property="Foreground" Value="{DynamicResource StrongTextBrush}" /></Style>
    <Style Selector="Button.channel.unread TextBlock"><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{DynamicResource EmphasisTextBrush}" /></Style>
    <Style Selector="Button.channel.muted TextBlock"><Setter Property="Foreground" Value="{DynamicResource QuietTextBrush}" /><Setter Property="FontWeight" Value="Normal" /></Style>
    <Style Selector="Button.channel.mention TextBlock"><Setter Property="Foreground" Value="{DynamicResource StrongTextBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style Selector="Border.unreadMark"><Setter Property="Width" Value="4" /><Setter Property="Height" Value="8" /><Setter Property="CornerRadius" Value="0,2,2,0" /><Setter Property="Background" Value="{DynamicResource EmphasisTextBrush}" /><Setter Property="HorizontalAlignment" Value="Left" /><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="Margin" Value="-8,0,0,0" /></Style>
    <Style Selector="Border.mentionMark"><Setter Property="MinWidth" Value="16" /><Setter Property="Height" Value="16" /><Setter Property="CornerRadius" Value="8" /><Setter Property="Background" Value="{DynamicResource MentionBadgeBrush}" /><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="Padding" Value="4,0" /></Style>
    <Style Selector="Button.channel.muted PathIcon"><Setter Property="Foreground" Value="{DynamicResource QuietTextBrush}" /></Style>
    <Style Selector="Button.memberRow"><Setter Property="Background" Value="Transparent" /><Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="CornerRadius" Value="2" /><Setter Property="Padding" Value="4,3" /><Setter Property="Margin" Value="0,0,0,1" /></Style>
    <Style Selector="Button.memberRow:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource HoverBrush}" /></Style>
    <Style Selector="Button.memberRow.self TextBlock"><Setter Property="Foreground" Value="{DynamicResource StrongTextBrush}" /><Setter Property="FontWeight" Value="Medium" /></Style>
  </UserControl.Styles>
  <Border Background="{DynamicResource SidebarBrush}">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="8,13,8,16" Spacing="0" IsVisible="{Binding ShowChannelNav}">
        <StackPanel IsVisible="{Binding HasDirectChannels}" Margin="0,0,0,8">
          <Button Classes="groupHeader" Command="{Binding ToggleDirectMessages}" AutomationProperties.Name="{i18n:T DirectMessages}">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <PathIcon Classes="groupChevron" Classes.collapsed="{Binding !DirectExpanded}" Data="{StaticResource IconChevronDown}" Width="9" Height="9" VerticalAlignment="Center" />
              <TextBlock Text="{i18n:T DirectMessages}" FontSize="11" FontWeight="Medium" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <motion:RevealHost IsOpen="{Binding DirectExpanded}">
            <ItemsControl ItemsSource="{Binding DirectChannels}">
              <ItemsControl.ItemTemplate><DataTemplate x:DataType="ch:ChannelItem">
                <Button Classes="channel" Classes.selected="{Binding IsSelected}" Classes.unread="{Binding HasUnread}" Classes.mention="{Binding HasMention}" Classes.muted="{Binding IsMuted}" Command="{Binding #Sidebar.((vm:ShellViewModel)DataContext).SelectOpenChannel}" CommandParameter="{Binding}" Margin="0,0,0,2" AutomationProperties.Name="{Binding Name}" Loaded="OnChannelLoaded">
                  <Button.ContextMenu><ContextMenu Opening="OnChannelMenuOpening">
                    <MenuItem Header="{i18n:T OpenChannel}" />
                    <MenuItem Header="{i18n:T MarkAsRead}" />
                    <MenuItem Header="{i18n:T MarkAsUnread}" />
                    <Separator />
                    <MenuItem Header="{i18n:T NotificationsAll}" />
                    <MenuItem Header="{i18n:T NotificationsMentions}" />
                    <MenuItem Header="{i18n:T NotificationsMute}" />
                    <Separator />
                    <MenuItem Header="{i18n:T RenameChannel}" />
                    <MenuItem Header="{i18n:T CreateChannel}" />
                    <Separator />
                    <MenuItem Header="{i18n:T DeleteChannel}" Foreground="{DynamicResource DangerActionBrush}" />
                  </ContextMenu></Button.ContextMenu>
                  <Panel>
                    <Border Classes="unreadMark" IsVisible="{Binding HasUnread}" />
                    <Grid ColumnDefinitions="16,*,Auto" ColumnSpacing="9">
                      <PathIcon Data="{StaticResource IconPeople}" Width="15" Height="15" Foreground="{DynamicResource QuietTextBrush}" />
                      <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                      <Border Grid.Column="2" Classes="mentionMark" IsVisible="{Binding HasMention}">
                        <TextBlock Text="@" FontSize="9" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                    </Grid>
                  </Panel>
                </Button>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
          </motion:RevealHost>
        </StackPanel>
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,5">
          <Button Classes="groupHeader" Command="{Binding ToggleTextChannels}" AutomationProperties.Name="{i18n:T TextChannels}">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <PathIcon Classes="groupChevron" Classes.collapsed="{Binding !TextExpanded}" Data="{StaticResource IconChevronDown}" Width="9" Height="9" VerticalAlignment="Center" />
              <TextBlock Text="{i18n:T TextChannels}" FontSize="11" FontWeight="Medium" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Grid.Column="1" Classes="groupAdd" Command="{Binding AddTextChannel}" IsVisible="{Binding CanModerate}" ToolTip.Tip="{i18n:T CreateTextChannel}" AutomationProperties.Name="{i18n:T CreateTextChannel}">
            <PathIcon Data="{StaticResource IconAdd}" Width="12" Height="12" />
          </Button>
        </Grid>
        <motion:RevealHost IsOpen="{Binding TextExpanded}">
        <StackPanel>
        <motion:RevealHost IsOpen="{Binding HasNewTextChannelEditor}">
          <ContentControl Content="{Binding NewTextChannelEditor}">
            <ContentControl.ContentTemplate><DataTemplate x:DataType="ch:ChannelEditorViewModel"><ch:ChannelEditor /></DataTemplate></ContentControl.ContentTemplate>
          </ContentControl>
        </motion:RevealHost>
        <ItemsControl ItemsSource="{Binding TextChannels}">
          <ItemsControl.ItemTemplate><DataTemplate x:DataType="ch:ChannelItem">
            <Panel>
            <Button IsVisible="{Binding !IsEditing}" Classes="channel" Classes.selected="{Binding IsSelected}" Classes.unread="{Binding HasUnread}" Classes.mention="{Binding HasMention}" Classes.muted="{Binding IsMuted}" Command="{Binding #Sidebar.((vm:ShellViewModel)DataContext).SelectOpenChannel}" CommandParameter="{Binding}" Margin="0,0,0,2" AutomationProperties.Name="{Binding Name}" Loaded="OnChannelLoaded">
              <Button.ContextMenu><ContextMenu Opening="OnChannelMenuOpening">
                <MenuItem Header="{i18n:T OpenChannel}" />
                <MenuItem Header="{i18n:T MarkAsRead}" />
                <MenuItem Header="{i18n:T MarkAsUnread}" />
                <Separator />
                <MenuItem Header="{i18n:T NotificationsAll}" />
                <MenuItem Header="{i18n:T NotificationsMentions}" />
                <MenuItem Header="{i18n:T NotificationsMute}" />
                <Separator />
                <MenuItem Header="{i18n:T RenameChannel}" />
                <MenuItem Header="{i18n:T CreateChannel}" />
                <Separator />
                <MenuItem Header="{i18n:T DeleteChannel}" Foreground="{DynamicResource DangerActionBrush}" />
              </ContextMenu></Button.ContextMenu>
              <Panel>
                <Border Classes="unreadMark" IsVisible="{Binding HasUnread}" />
                <Grid ColumnDefinitions="16,*,Auto" ColumnSpacing="9">
                  <PathIcon Data="{StaticResource IconHash}" Width="15" Height="15" Foreground="{DynamicResource QuietTextBrush}" />
                  <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  <Border Grid.Column="2" Classes="mentionMark" IsVisible="{Binding HasMention}">
                    <TextBlock Text="@" FontSize="9" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                </Grid>
              </Panel>
            </Button>
            <ContentControl Content="{Binding Editor}" IsVisible="{Binding IsEditing}">
              <ContentControl.ContentTemplate><DataTemplate x:DataType="ch:ChannelEditorViewModel"><ch:ChannelEditor /></DataTemplate></ContentControl.ContentTemplate>
            </ContentControl>
            </Panel>
          </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
        </StackPanel>
        </motion:RevealHost>
        <Grid ColumnDefinitions="*,Auto" Margin="0,19,0,5">
          <Button Classes="groupHeader" Command="{Binding ToggleVoiceChannels}" AutomationProperties.Name="{i18n:T VoiceChannels}">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <PathIcon Classes="groupChevron" Classes.collapsed="{Binding !VoiceExpanded}" Data="{StaticResource IconChevronDown}" Width="9" Height="9" VerticalAlignment="Center" />
              <TextBlock Text="{i18n:T VoiceChannels}" FontSize="11" FontWeight="Medium" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Grid.Column="1" Classes="groupAdd" Command="{Binding AddVoiceChannel}" IsVisible="{Binding CanModerate}" ToolTip.Tip="{i18n:T CreateVoiceChannel}" AutomationProperties.Name="{i18n:T CreateVoiceChannel}">
            <PathIcon Data="{StaticResource IconAdd}" Width="12" Height="12" />
          </Button>
        </Grid>
        <motion:RevealHost IsOpen="{Binding VoiceExpanded}">
        <StackPanel>
        <motion:RevealHost IsOpen="{Binding HasNewVoiceChannelEditor}">
          <ContentControl Content="{Binding NewVoiceChannelEditor}">
            <ContentControl.ContentTemplate><DataTemplate x:DataType="ch:ChannelEditorViewModel"><ch:ChannelEditor /></DataTemplate></ContentControl.ContentTemplate>
          </ContentControl>
        </motion:RevealHost>
        <ItemsControl ItemsSource="{Binding VoiceChannels}">
          <ItemsControl.ItemTemplate><DataTemplate x:DataType="ch:ChannelItem">
            <StackPanel>
            <Button IsVisible="{Binding !IsEditing}" Classes="channel" Classes.selected="{Binding IsSelected}" Classes.connected="{Binding IsConnected}" Classes.unread="{Binding HasUnread}" Classes.mention="{Binding HasMention}" Classes.muted="{Binding IsMuted}" Command="{Binding #Sidebar.((vm:ShellViewModel)DataContext).JoinVoice}" CommandParameter="{Binding}" Margin="0,0,0,2" AutomationProperties.Name="{Binding Name}" ToolTip.Tip="{i18n:T VoiceJoinHint}" Loaded="OnChannelLoaded">
              <Button.ContextMenu><ContextMenu Opening="OnVoiceMenuOpening">
                <MenuItem Header="{i18n:T JoinVoiceChannel}" />
                <MenuItem Header="{i18n:T CopyWebVoiceLink}" />
                <MenuItem Header="{i18n:T VoiceChannelSettings}" />
                <Separator />
                <MenuItem Header="{i18n:T RenameChannel}" />
                <MenuItem Header="{i18n:T CreateChannel}" />
                <Separator />
                <MenuItem Header="{i18n:T DeleteChannel}" Foreground="{DynamicResource DangerActionBrush}" />
              </ContextMenu></Button.ContextMenu>
              <Panel>
                <Border Classes="unreadMark" IsVisible="{Binding HasUnread}" />
                <Grid ColumnDefinitions="16,*,Auto" ColumnSpacing="9">
                  <PathIcon Data="{StaticResource IconSpeaker}" Width="15" Height="15" Foreground="{DynamicResource QuietTextBrush}" />
                  <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  <Border Grid.Column="2" Classes="mentionMark" IsVisible="{Binding HasMention}">
                    <TextBlock Text="@" FontSize="9" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                </Grid>
              </Panel>
            </Button>
            <ItemsControl ItemsSource="{Binding VoiceMembers}" IsVisible="{Binding HasVoiceMembers}" Margin="24,0,0,6">
              <ItemsControl.ItemTemplate><DataTemplate x:DataType="ch:VoiceMemberRow">
                <Button Classes="memberRow" Classes.self="{Binding IsSelf}" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{Binding Name}">
                  <Button.Flyout>
                    <Flyout Placement="RightEdgeAlignedTop" FlyoutPresenterClasses="userCardFlyout" Opened="OnCardOpened">
                      <chat:UserCard />
                    </Flyout>
                  </Button.Flyout>
                  <Grid ColumnDefinitions="20,*,Auto" ColumnSpacing="8">
                    <c:Avatar Width="20" Height="20" Playback="{Binding Playback}" Initial="{Binding Initial}" Speaking="{Binding Speaking}" />
                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <Panel Grid.Column="2" Width="14" Height="14" VerticalAlignment="Center" Opacity="0.9">
                      <Panel IsVisible="{Binding ShowMute}">
                        <PathIcon Data="{StaticResource IconMic}" Width="13" Height="13" Foreground="{DynamicResource QuietTextBrush}" />
                        <Path Data="M1,1 L13,13" Stroke="{DynamicResource DangerBrush}" StrokeThickness="1.3" />
                      </Panel>
                      <Panel IsVisible="{Binding Deafened}">
                        <PathIcon Data="{StaticResource IconHeadphones}" Width="13" Height="13" Foreground="{DynamicResource QuietTextBrush}" />
                        <Path Data="M1,1 L13,13" Stroke="{DynamicResource DangerBrush}" StrokeThickness="1.3" />
                      </Panel>
                    </Panel>
                  </Grid>
                </Button>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <ContentControl Content="{Binding Editor}" IsVisible="{Binding IsEditing}">
              <ContentControl.ContentTemplate><DataTemplate x:DataType="ch:ChannelEditorViewModel"><ch:ChannelEditor /></DataTemplate></ContentControl.ContentTemplate>
            </ContentControl>
            </StackPanel>
          </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
        </StackPanel>
        </motion:RevealHost>
      </StackPanel>
    </ScrollViewer>
  </Border>
</UserControl>
