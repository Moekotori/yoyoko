<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Chat.UI.Shell" xmlns:ch="using:Chat.UI.Channels" xmlns:i18n="using:Chat.UI.Localization"
 x:Class="Chat.UI.Channels.ChannelSidebar" x:DataType="vm:ShellViewModel" x:Name="Sidebar">
  <UserControl.Styles>
    <Style Selector="Button.groupHeader"><Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="HorizontalContentAlignment" Value="Left" /><Setter Property="Height" Value="30" /><Setter Property="Padding" Value="8,0" /><Setter Property="CornerRadius" Value="2" /><Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" /></Style>
    <Style Selector="Button.groupAdd"><Setter Property="Width" Value="26" /><Setter Property="Height" Value="26" /><Setter Property="Padding" Value="7" /><Setter Property="CornerRadius" Value="2" /><Setter Property="Foreground" Value="{DynamicResource QuietTextBrush}" /></Style>
    <Style Selector="Button.channel"><Setter Property="CornerRadius" Value="2" /><Setter Property="Height" Value="32" /><Setter Property="Padding" Value="10,0" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style>
    <Style Selector="Button.channel.selected"><Setter Property="Background" Value="#343434" /></Style>
    <Style Selector="Button.channel.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#3A3A3A" /></Style>
    <Style Selector="Button.channel.selected PathIcon"><Setter Property="Foreground" Value="#D5D5D5" /></Style>
    <Style Selector="Button.channel.selected TextBlock"><Setter Property="FontWeight" Value="Medium" /><Setter Property="Foreground" Value="#E8E8E8" /></Style>
    <Style Selector="Button.channel.connected PathIcon"><Setter Property="Foreground" Value="#C8C8C8" /></Style>
    <Style Selector="Button.channel.connected TextBlock"><Setter Property="Foreground" Value="#E8E8E8" /></Style>
    <Style Selector="Button.channel.unread TextBlock"><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="#F2F2F2" /></Style>
    <Style Selector="Button.channel.muted TextBlock"><Setter Property="Foreground" Value="#6E6E6E" /><Setter Property="FontWeight" Value="Normal" /></Style>
    <Style Selector="Button.channel.mention TextBlock"><Setter Property="Foreground" Value="#E8E8E8" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style Selector="Border.unreadMark"><Setter Property="Width" Value="3" /><Setter Property="Height" Value="8" /><Setter Property="CornerRadius" Value="0,2,2,0" /><Setter Property="Background" Value="#E8E8E8" /><Setter Property="HorizontalAlignment" Value="Left" /></Style>
    <Style Selector="Border.mentionMark"><Setter Property="Width" Value="8" /><Setter Property="Height" Value="8" /><Setter Property="CornerRadius" Value="4" /><Setter Property="Background" Value="#C45C56" /><Setter Property="VerticalAlignment" Value="Center" /></Style>
  </UserControl.Styles>
  <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,0">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="8,13,8,16" Spacing="0" IsVisible="{Binding IsSignedIn}">
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,5">
          <Button Classes="groupHeader" Command="{Binding ToggleTextChannels}" AutomationProperties.Name="{i18n:T TextChannels}">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <Panel Width="10" Height="10" VerticalAlignment="Center">
                <PathIcon Data="{StaticResource IconChevronDown}" Width="9" Height="9" IsVisible="{Binding TextExpanded}" />
                <PathIcon Data="M 2,0 L 7,5 L 2,10 L 1,9 L 5,5 L 1,1 Z" Width="9" Height="9" IsVisible="{Binding !TextExpanded}" />
              </Panel>
              <TextBlock Text="{i18n:T TextChannels}" FontSize="11" FontWeight="Medium" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Grid.Column="1" Classes="groupAdd" Command="{Binding AddTextChannel}" IsVisible="{Binding CanModerate}" ToolTip.Tip="{i18n:T CreateTextChannel}" AutomationProperties.Name="{i18n:T CreateTextChannel}">
            <PathIcon Data="{StaticResource IconAdd}" Width="12" Height="12" />
          </Button>
        </Grid>
        <ItemsControl ItemsSource="{Binding TextChannels}" IsVisible="{Binding TextExpanded}">
          <ItemsControl.ItemTemplate><DataTemplate x:DataType="ch:ChannelItem">
            <Panel>
            <Button IsVisible="{Binding !IsEditing}" Classes="channel" Classes.selected="{Binding IsSelected}" Classes.unread="{Binding HasUnread}" Classes.mention="{Binding HasMention}" Classes.muted="{Binding IsMuted}" Command="{Binding #Sidebar.((vm:ShellViewModel)DataContext).SelectOpenChannel}" CommandParameter="{Binding}" Margin="0,0,0,2" AutomationProperties.Name="{Binding Name}" Loaded="OnChannelLoaded">
              <Button.ContextMenu><ContextMenu Opening="OnChannelMenuOpening">
                <MenuItem Header="{i18n:T OpenChannel}" />
                <MenuItem Header="{i18n:T MarkAsRead}" />
                <MenuItem Header="{i18n:T MarkAsUnread}" />
                <Separator />
                <MenuItem Header="{i18n:T NotificationsAll}" />
                <MenuItem Header="{i18n:T NotificationsMentions}" />
                <MenuItem Header="{i18n:T NotificationsMute}" />
                <Separator />
                <MenuItem Header="{i18n:T RenameChannel}" />
                <MenuItem Header="{i18n:T CreateChannel}" />
                <Separator />
                <MenuItem Header="{i18n:T DeleteChannel}" Foreground="#E3A09A" />
              </ContextMenu></Button.ContextMenu>
              <Grid ColumnDefinitions="16,*,10" ColumnSpacing="9">
                <Panel>
                  <Border Classes="unreadMark" IsVisible="{Binding HasUnread}" Margin="-10,0,0,0" />
                  <PathIcon Data="{StaticResource IconHash}" Width="15" Height="15" Foreground="{DynamicResource QuietTextBrush}" />
                </Panel>
                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <Border Grid.Column="2" Classes="mentionMark" IsVisible="{Binding HasMention}" />
              </Grid>
            </Button>
            <ContentControl Content="{Binding Editor}" IsVisible="{Binding IsEditing}">
              <ContentControl.ContentTemplate><DataTemplate x:DataType="ch:ChannelEditorViewModel"><ch:ChannelEditor /></DataTemplate></ContentControl.ContentTemplate>
            </ContentControl>
            </Panel>
          </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
        <ContentControl Content="{Binding NewTextChannelEditor}" IsVisible="{Binding HasNewTextChannelEditor}">
          <ContentControl.ContentTemplate><DataTemplate x:DataType="ch:ChannelEditorViewModel"><ch:ChannelEditor /></DataTemplate></ContentControl.ContentTemplate>
        </ContentControl>
        <Grid ColumnDefinitions="*,Auto" Margin="0,19,0,5">
          <Button Classes="groupHeader" Command="{Binding ToggleVoiceChannels}" AutomationProperties.Name="{i18n:T VoiceChannels}">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <Panel Width="10" Height="10" VerticalAlignment="Center">
                <PathIcon Data="{StaticResource IconChevronDown}" Width="9" Height="9" IsVisible="{Binding VoiceExpanded}" />
                <PathIcon Data="M 2,0 L 7,5 L 2,10 L 1,9 L 5,5 L 1,1 Z" Width="9" Height="9" IsVisible="{Binding !VoiceExpanded}" />
              </Panel>
              <TextBlock Text="{i18n:T VoiceChannels}" FontSize="11" FontWeight="Medium" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Grid.Column="1" Classes="groupAdd" Command="{Binding AddVoiceChannel}" IsVisible="{Binding CanModerate}" ToolTip.Tip="{i18n:T CreateVoiceChannel}" AutomationProperties.Name="{i18n:T CreateVoiceChannel}">
            <PathIcon Data="{StaticResource IconAdd}" Width="12" Height="12" />
          </Button>
        </Grid>
        <ItemsControl ItemsSource="{Binding VoiceChannels}" IsVisible="{Binding VoiceExpanded}">
          <ItemsControl.ItemTemplate><DataTemplate x:DataType="ch:ChannelItem">
            <StackPanel>
            <Button IsVisible="{Binding !IsEditing}" Classes="channel" Classes.selected="{Binding IsSelected}" Classes.connected="{Binding IsConnected}" Margin="0,0,0,2" AutomationProperties.Name="{Binding Name}" ToolTip.Tip="{i18n:T VoiceJoinHint}" Loaded="OnChannelLoaded" DoubleTapped="OnVoiceDoubleTapped">
              <Button.ContextMenu><ContextMenu Opening="OnVoiceMenuOpening">
                <MenuItem Header="{i18n:T JoinVoiceChannel}" />
                <MenuItem Header="{i18n:T Settings}" />
                <Separator />
                <MenuItem Header="{i18n:T RenameChannel}" />
                <MenuItem Header="{i18n:T CreateChannel}" />
                <Separator />
                <MenuItem Header="{i18n:T DeleteChannel}" Foreground="#E3A09A" />
              </ContextMenu></Button.ContextMenu>
              <Grid ColumnDefinitions="16,*" ColumnSpacing="9">
                <PathIcon Data="{StaticResource IconSpeaker}" Width="15" Height="15" Foreground="{DynamicResource QuietTextBrush}" />
                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              </Grid>
            </Button>
            <ItemsControl ItemsSource="{Binding VoiceMembers}" IsVisible="{Binding HasVoiceMembers}" Margin="26,0,0,4">
              <ItemsControl.ItemTemplate><DataTemplate x:DataType="ch:VoiceMemberRow">
                <Grid ColumnDefinitions="16,*,Auto" ColumnSpacing="8" Height="22">
                  <Border Width="16" Height="16" CornerRadius="8" Background="#3A3A3A" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Initial}" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  <Panel Grid.Column="2" Width="12" Height="12" VerticalAlignment="Center" IsVisible="{Binding Muted}">
                    <PathIcon Data="{StaticResource IconMic}" Width="12" Height="12" Foreground="{DynamicResource QuietTextBrush}" />
                    <Path Data="M1,1 L11,11" Stroke="#ED9292" StrokeThickness="1.4" />
                  </Panel>
                </Grid>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <ContentControl Content="{Binding Editor}" IsVisible="{Binding IsEditing}">
              <ContentControl.ContentTemplate><DataTemplate x:DataType="ch:ChannelEditorViewModel"><ch:ChannelEditor /></DataTemplate></ContentControl.ContentTemplate>
            </ContentControl>
            </StackPanel>
          </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
        <ContentControl Content="{Binding NewVoiceChannelEditor}" IsVisible="{Binding HasNewVoiceChannelEditor}">
          <ContentControl.ContentTemplate><DataTemplate x:DataType="ch:ChannelEditorViewModel"><ch:ChannelEditor /></DataTemplate></ContentControl.ContentTemplate>
        </ContentControl>
      </StackPanel>
    </ScrollViewer>
  </Border>
</UserControl>
