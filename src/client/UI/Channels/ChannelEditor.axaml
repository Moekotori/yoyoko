<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ch="using:Chat.UI.Channels" xmlns:i18n="using:Chat.UI.Localization"
 x:Class="Chat.UI.Channels.ChannelEditor" x:DataType="ch:ChannelEditorViewModel">
  <UserControl.KeyBindings><KeyBinding Gesture="Escape" Command="{Binding Cancel}" /></UserControl.KeyBindings>
  <UserControl.Styles>
    <Style Selector="Button.inlineAction"><Setter Property="Width" Value="22" /><Setter Property="Height" Value="22" /><Setter Property="Padding" Value="5" /><Setter Property="CornerRadius" Value="2" /><Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" /></Style>
    <Style Selector="TextBox"><Setter Property="MinHeight" Value="0" /><Setter Property="Height" Value="32" /><Setter Property="FontSize" Value="13" /><Setter Property="Padding" Value="0" /><Setter Property="BorderThickness" Value="0" /><Setter Property="CornerRadius" Value="0" /><Setter Property="Background" Value="Transparent" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
    <!-- Keep the native text editor, but remove its Fluent background/border in every state. -->
    <Style Selector="TextBox.inlineName /template/ Border#PART_BorderElement"><Setter Property="IsVisible" Value="False" /></Style>
  </UserControl.Styles>
  <StackPanel Spacing="4" Margin="0,0,0,2">
    <Border Background="{DynamicResource ChannelSelectedBrush}" BorderThickness="0" Padding="10,0" CornerRadius="2" Height="32" IsVisible="{Binding !IsDelete}">
      <Grid ColumnDefinitions="16,*,Auto" ColumnSpacing="9">
        <PathIcon Data="{StaticResource IconHash}" Width="15" Height="15" VerticalAlignment="Center" IsVisible="{Binding !IsVoice}" Foreground="{DynamicResource QuietTextBrush}" />
        <PathIcon Data="{StaticResource IconSpeaker}" Width="15" Height="15" VerticalAlignment="Center" IsVisible="{Binding IsVoice}" Foreground="{DynamicResource QuietTextBrush}" />
        <TextBox Grid.Column="1" Classes="inlineName" x:Name="NameInput" Text="{Binding Name}" MaxLength="100" PlaceholderText="{i18n:T NewChannelName}" IsEnabled="{Binding !IsBusy}" AutomationProperties.Name="{i18n:T NewChannelName}">
          <TextBox.KeyBindings><KeyBinding Gesture="Enter" Command="{Binding Submit}" /></TextBox.KeyBindings>
        </TextBox>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
          <Button Classes="inlineAction" Command="{Binding Submit}" IsEnabled="{Binding !IsBusy}" ToolTip.Tip="{Binding SubmitLabel}" AutomationProperties.Name="{Binding SubmitLabel}">
            <PathIcon Data="M 1,6 L 4,9 L 11,2 L 12,3 L 4,11 L 0,7 Z" Width="12" Height="12" />
          </Button>
          <Button Classes="inlineAction" Command="{Binding Cancel}" IsEnabled="{Binding !IsBusy}" ToolTip.Tip="{i18n:T ChannelCancel}" AutomationProperties.Name="{i18n:T ChannelCancel}">
            <PathIcon Data="{StaticResource IconClose}" Width="11" Height="11" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>
    <StackPanel Margin="9,5" Spacing="7" IsVisible="{Binding IsDelete}">
      <TextBlock Text="{Binding Confirmation}" FontSize="12" TextWrapping="Wrap" />
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button x:Name="CancelButton" Content="{i18n:T ChannelCancel}" Command="{Binding Cancel}" IsEnabled="{Binding !IsBusy}" FontSize="12" Padding="7,4" />
        <Button Content="{Binding SubmitLabel}" Command="{Binding Submit}" IsEnabled="{Binding !IsBusy}" Foreground="{DynamicResource DangerActionBrush}" FontSize="12" Padding="7,4" />
      </StackPanel>
    </StackPanel>
    <TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}" Foreground="{DynamicResource DangerActionBrush}" FontSize="11" TextWrapping="Wrap" Margin="10,0,4,4" />
  </StackPanel>
</UserControl>
