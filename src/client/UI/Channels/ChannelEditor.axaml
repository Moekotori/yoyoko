<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ch="using:Chat.UI.Channels" xmlns:i18n="using:Chat.UI.Localization"
 x:Class="Chat.UI.Channels.ChannelEditor" x:DataType="ch:ChannelEditorViewModel"
 KeyboardNavigation.TabNavigation="Cycle">
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding Cancel}" />
  </UserControl.KeyBindings>
  <UserControl.Styles>
    <Style Selector="TextBox /template/ Border#PART_BorderElement"><Setter Property="Background" Value="#202020" /><Setter Property="CornerRadius" Value="2" /></Style>
    <Style Selector="Button"><Setter Property="CornerRadius" Value="2" /></Style>
    <Style Selector="Button.danger"><Setter Property="Background" Value="#A54642" /><Setter Property="Foreground" Value="White" /></Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#BB514B" /><Setter Property="Foreground" Value="White" /></Style>
  </UserControl.Styles>
  <Border Width="380" Background="#252525" BorderBrush="#414141" BorderThickness="1" CornerRadius="2" Padding="24">
    <StackPanel Spacing="20">
      <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" />
      <StackPanel Spacing="8" IsVisible="{Binding !IsDelete}">
        <TextBlock Text="{i18n:T NewChannelName}" FontSize="12" Classes="muted" />
        <TextBox x:Name="NameInput" Text="{Binding Name}" MaxLength="100" CornerRadius="2" IsEnabled="{Binding !IsBusy}" AutomationProperties.Name="{i18n:T NewChannelName}">
          <TextBox.KeyBindings><KeyBinding Gesture="Enter" Command="{Binding Submit}" /></TextBox.KeyBindings>
        </TextBox>
      </StackPanel>
      <TextBlock Text="{Binding Confirmation}" IsVisible="{Binding IsDelete}" TextWrapping="Wrap" LineHeight="22" />
      <TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}" Foreground="#E5A19A" FontSize="12" TextWrapping="Wrap" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
        <Button x:Name="CancelButton" Content="{i18n:T ChannelCancel}" Command="{Binding Cancel}" IsEnabled="{Binding !IsBusy}" Padding="16,9" />
        <Button Content="{Binding SubmitLabel}" Command="{Binding Submit}" Classes="primary" Classes.danger="{Binding IsDelete}" IsEnabled="{Binding !IsBusy}" Padding="16,9" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
