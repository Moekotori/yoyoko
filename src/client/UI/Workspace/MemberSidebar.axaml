<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Chat.UI.Workspace" xmlns:c="using:Chat.UI.Components" xmlns:i18n="using:Chat.UI.Localization" xmlns:chat="using:Chat.UI.Chat"
  x:Class="Chat.UI.Workspace.MemberSidebar" x:DataType="vm:WorkspaceViewModel">
  <UserControl.Styles>
    <Style Selector="Button.memberRow">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="Margin" Value="0,0,0,1" />
    </Style>
  </UserControl.Styles>
  <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1,0,0,0" Width="220">
    <Grid RowDefinitions="52,*">
      <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" Padding="16,0">
        <TextBlock Text="{i18n:T Members}" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" />
      </Border>
      <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="8,12,8,16" Spacing="2">
          <TextBlock Text="{Binding MemberHeading}" Classes="section" Margin="8,0,8,8" />
          <ItemsControl ItemsSource="{Binding Members}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="chat:MemberProfile">
                <Button Classes="memberRow" AutomationProperties.Name="{Binding Name}">
                  <Button.Flyout>
                    <Flyout Placement="LeftEdgeAlignedTop" Opened="OnCardOpened">
                      <chat:UserCard DataContext="{Binding}" />
                    </Flyout>
                  </Button.Flyout>
                  <Button.ContextMenu>
                    <ContextMenu DataContext="{Binding}" Opening="OnMemberMenuOpening">
                      <MenuItem Header="{i18n:T MentionMember}" />
                      <MenuItem Header="{i18n:T CopyUsername}" />
                      <MenuItem Header="{i18n:T CopyUserId}" />
                      <MenuItem Header="{i18n:T Profile}" />
                      <Separator />
                      <MenuItem Header="{i18n:T KickMember}" Foreground="#E3A09A" />
                      <MenuItem Header="{i18n:T BanMember}" Foreground="#E3A09A" />
                    </ContextMenu>
                  </Button.ContextMenu>
                  <Grid ColumnDefinitions="28,*" ColumnSpacing="10">
                    <c:Avatar Width="28" Height="28" Source="{Binding Image}" Initial="{Binding Initial}" IsOnline="True" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                      <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{i18n:T Online}" Classes="quiet" FontSize="11" />
                    </StackPanel>
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Border>
</UserControl>
