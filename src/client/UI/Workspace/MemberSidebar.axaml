<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Chat.UI.Workspace" xmlns:c="using:Chat.UI.Components" xmlns:i18n="using:Chat.UI.Localization" xmlns:chat="using:Chat.UI.Chat"
  x:Class="Chat.UI.Workspace.MemberSidebar" x:DataType="vm:WorkspaceViewModel" Width="300">
  <UserControl.Styles>
    <Style Selector="Button.memberRow">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Padding" Value="8,8" />
      <Setter Property="Margin" Value="0,0,0,2" />
      <Setter Property="Width" Value="280" />
    </Style>
    <Style Selector="ItemsControl, StackPanel, ContentPresenter">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.memberRow.offline"><Setter Property="Opacity" Value="0.58" /></Style>
    <Style Selector="Button.memberRow:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    </Style>
  </UserControl.Styles>
  <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1,0,0,0">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <ItemsControl ItemsSource="{Binding MemberSections}" Margin="10,12,10,20" AutomationProperties.Name="{i18n:T Members}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="chat:MemberSection">
            <StackPanel Margin="0,0,0,12">
              <TextBlock Text="{Binding Title}" Classes="section" FontSize="12" Margin="8,8,8,8" />
              <ItemsControl ItemsSource="{Binding People}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="chat:MemberProfile">
                    <Button Classes="memberRow" Classes.offline="{Binding !IsOnline}" AutomationProperties.Name="{Binding Name}">
                      <Button.Flyout>
                        <Flyout Placement="LeftEdgeAlignedTop" FlyoutPresenterClasses="userCardFlyout" Opened="OnCardOpened">
                          <chat:UserCard DataContext="{Binding}" />
                        </Flyout>
                      </Button.Flyout>
                      <Button.ContextMenu>
                        <ContextMenu DataContext="{Binding}" Opening="OnMemberMenuOpening">
                          <MenuItem Header="{i18n:T MessageUser}" Tag="message" />
                          <MenuItem Header="{i18n:T MentionMember}" Tag="mention" />
                          <MenuItem Header="{i18n:T CopyUsername}" Tag="copy-name" />
                          <MenuItem Header="{i18n:T CopyUserId}" Tag="copy-id" />
                          <MenuItem Header="{i18n:T Profile}" Tag="profile" />
                          <Separator />
                          <MenuItem Header="{i18n:T KickMember}" Tag="kick" Foreground="{DynamicResource DangerActionBrush}" />
                          <MenuItem Header="{i18n:T BanMember}" Tag="ban" Foreground="{DynamicResource DangerActionBrush}" />
                        </ContextMenu>
                      </Button.ContextMenu>
                      <DockPanel MinWidth="252">
                        <c:Avatar DockPanel.Dock="Left" Width="40" Height="40" Margin="0,0,10,0" Source="{Binding Image}" Initial="{Binding Initial}" IsOnline="{Binding IsOnline}" />
                        <StackPanel VerticalAlignment="Center" Spacing="1" MinWidth="210">
                          <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Handle}" Classes="quiet" FontSize="12" IsVisible="{Binding HasHandle}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </DockPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Border>
</UserControl>
