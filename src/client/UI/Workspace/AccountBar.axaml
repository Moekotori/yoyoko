<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Chat.UI.Workspace" xmlns:c="using:Chat.UI.Components" xmlns:i18n="using:Chat.UI.Localization"
  x:Class="Chat.UI.Workspace.AccountBar" x:DataType="vm:WorkspaceViewModel">
  <Border Background="{DynamicResource ChromeBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,1,0" Padding="16,12">
    <Grid ColumnDefinitions="34,*,Auto" ColumnSpacing="10">
      <c:Avatar Width="34" Height="34" Source="{Binding AccountAvatar}" Initial="{Binding AccountInitial}" VerticalAlignment="Center" />
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
        <TextBlock Text="{Binding AccountName}" FontSize="13" FontWeight="Medium" />
        <TextBlock Text="{Binding AccountStatus}" Classes="muted" FontSize="10" />
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="2">
        <Button Classes="icon" Command="{Binding Unavailable}" ToolTip.Tip="{i18n:T MicUnavailable}" AutomationProperties.Name="{i18n:T Mic}"><PathIcon Data="{StaticResource IconMic}" Width="17" Height="17" /></Button>
        <Button Classes="icon" Command="{Binding Unavailable}" ToolTip.Tip="{i18n:T HeadphonesUnavailable}" AutomationProperties.Name="{i18n:T Headphones}"><PathIcon Data="{StaticResource IconHeadphones}" Width="17" Height="17" /></Button>
        <Button Classes="icon" Command="{Binding Unavailable}" ToolTip.Tip="{i18n:T SettingsUnavailable}" AutomationProperties.Name="{i18n:T Settings}"><PathIcon Data="{StaticResource IconSettings}" Width="17" Height="17" /></Button>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
