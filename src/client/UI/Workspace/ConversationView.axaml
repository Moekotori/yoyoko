<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Chat.UI.Workspace" xmlns:c="using:Chat.UI.Components" xmlns:i18n="using:Chat.UI.Localization" xmlns:chat="using:Chat.UI.Chat" xmlns:motion="clr-namespace:Chat.Motion;assembly=Chat.Motion"
  x:Class="Chat.UI.Workspace.ConversationView" x:DataType="vm:WorkspaceViewModel" x:Name="Conversation">
  <UserControl.Styles>
    <Style Selector="ListBoxItem"><Setter Property="Padding" Value="0" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Focusable" Value="False" /></Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent" /></Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent" /></Style>
    <Style Selector="Grid.messageRow"><Setter Property="Background" Value="Transparent" /><Setter Property="Margin" Value="0,0,0,12" /></Style>
    <Style Selector="Grid.messageRow:pointerover"><Setter Property="Background" Value="#232323" /></Style>
    <Style Selector="Grid.messageRow.continued"><Setter Property="Margin" Value="0,0,0,2" /></Style>
    <Style Selector="Grid.messageRow.continued StackPanel.body"><Setter Property="Margin" Value="0,1,16,1" /></Style>
    <Style Selector="Grid.messageRow Panel.avatarSlot"><Setter Property="DockPanel.Dock" Value="Left" /><Setter Property="Margin" Value="0,12,13,0" /></Style>
    <Style Selector="Grid.messageRow StackPanel.body"><Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="Margin" Value="0,11,16,9" /></Style>
    <Style Selector="SelectableTextBlock.messageText"><Setter Property="FontSize" Value="16" /><Setter Property="LineHeight" Value="25" /><Setter Property="Foreground" Value="#CCCCCC" /></Style>
    <Style Selector="Button.mentionChip">
      <Setter Property="Padding" Value="4,0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Background" Value="#332820" />
      <Setter Property="Foreground" Value="#D2A88C" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.mentionChip.strong">
      <Setter Property="Background" Value="#4A3228" />
      <Setter Property="Foreground" Value="#E8C4A8" />
    </Style>
    <Style Selector="Border.messageTools"><Setter Property="IsVisible" Value="False" /><Setter Property="HorizontalAlignment" Value="Right" /><Setter Property="Margin" Value="0,0,24,0" /></Style>
    <Style Selector="Grid.messageRow:pointerover Border.messageTools"><Setter Property="IsVisible" Value="True" /></Style>
    <Style Selector="Grid.messageRow:focus-within Border.messageTools"><Setter Property="IsVisible" Value="True" /></Style>
  </UserControl.Styles>
  <Grid ColumnDefinitions="*,Auto">
    <Grid RowDefinitions="52,Auto,*,Auto">
      <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="24,0,18,0">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
            <PathIcon Data="{StaticResource IconHash}" Foreground="{DynamicResource QuietTextBrush}" Width="19" Height="19" />
            <TextBlock Text="{Binding ChannelName}" FontSize="15" FontWeight="Medium" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="5">
            <Button Classes="icon" Classes.active="{Binding SearchVisible}" Command="{Binding ToggleSearch}" ToolTip.Tip="{i18n:T SearchShortcut}" AutomationProperties.Name="{i18n:T SearchMessages}"><PathIcon Data="{StaticResource IconSearch}" /></Button>
            <Button Classes="icon" Classes.active="{Binding MembersVisible}" Command="{Binding ToggleMembers}" ToolTip.Tip="{i18n:T Members}" AutomationProperties.Name="{i18n:T ToggleMembers}"><PathIcon Data="{StaticResource IconPeople}" /></Button>
          </StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Row="1" ColumnDefinitions="*,30" Margin="24,12,24,0" IsVisible="{Binding SearchVisible}">
        <TextBox x:Name="SearchInput" Text="{Binding Query}" PlaceholderText="{i18n:T SearchInChannel}" AutomationProperties.Name="{i18n:T SearchContent}" />
        <Button Grid.Column="1" Classes="icon" Command="{Binding ToggleSearch}" AutomationProperties.Name="{i18n:T CloseSearch}"><PathIcon Data="{StaticResource IconClose}" Width="14" Height="14" /></Button>
      </Grid>
      <Grid Grid.Row="2" x:Name="TimelineSurface">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="9" IsVisible="{Binding HasNoMessages}">
          <PathIcon Data="{StaticResource IconHash}" Width="28" Height="28" Foreground="#757575" Margin="0,0,0,5" />
          <TextBlock Text="{Binding EmptyTitle}" HorizontalAlignment="Center" FontSize="15" Foreground="{DynamicResource MutedTextBrush}" />
          <TextBlock Text="{Binding EmptyDetail}" HorizontalAlignment="Center" FontSize="12" Foreground="{DynamicResource QuietTextBrush}" />
        </StackPanel>
        <ListBox x:Name="Timeline" ItemsSource="{Binding Messages}" Margin="0,22,0,12" SelectionMode="Single" AutoScrollToSelectedItem="False"
          motion:SmoothScroll.Wheel="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.BringIntoViewOnFocusChange="False"
          AutomationProperties.Name="{i18n:T MessageTimeline}">
          <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel CacheLength="1" /></ItemsPanelTemplate></ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:MessageItem">
              <Grid Classes="messageRow" Classes.continued="{Binding IsContinuation}">
                <Grid.ContextMenu><ContextMenu><MenuItem Header="{i18n:T CopyText}" Click="CopyMessage" /></ContextMenu></Grid.ContextMenu>
                <DockPanel Margin="24,0">
                  <Panel Classes="avatarSlot" Width="36" Height="36" VerticalAlignment="Top">
                    <c:Avatar Width="36" Height="36" Source="{Binding Avatar}" IsVisible="{Binding ShowHeader}" />
                  </Panel>
                  <StackPanel Classes="body" Spacing="4">
                    <StackPanel Classes="header" Orientation="Horizontal" Spacing="9" IsVisible="{Binding ShowHeader}">
                      <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="#E2E2E2" />
                      <TextBlock Text="{Binding Time}" Foreground="{DynamicResource QuietTextBrush}" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                    <chat:MessageText Markdown="{Binding Text}" SelfUsername="{Binding #Conversation.((vm:WorkspaceViewModel)DataContext).AccountName}" Classes="messageText" TextWrapping="Wrap" />
                    <Button Classes="reaction" IsVisible="{Binding HasReaction}" Background="#343434" BorderBrush="#505050" BorderThickness="1" CornerRadius="2" Padding="7,3" Margin="0,4,0,0" Command="{Binding #Conversation.((vm:WorkspaceViewModel)DataContext).Unavailable}" AutomationProperties.Name="{i18n:T ReactionUnavailable}">
                      <StackPanel Orientation="Horizontal" Spacing="6"><PathIcon Data="{StaticResource IconHeartFilled}" Foreground="{DynamicResource AccentBrush}" Width="14" Height="14" /><TextBlock Text="1" FontSize="11" Foreground="#D8D8D8" /></StackPanel>
                    </Button>
                  </StackPanel>
                </DockPanel>
                <Border Classes="messageTools" Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="2" VerticalAlignment="Top">
                  <Button Classes="icon" Click="CopyMessage" AutomationProperties.Name="{i18n:T CopyMessage}" ToolTip.Tip="{i18n:T CopyText}"><PathIcon Data="{StaticResource IconCopy}" Width="16" Height="16" /></Button>
                </Border>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
      <Border Grid.Row="3" Classes="composerFrame" Background="{DynamicResource RaisedBrush}" BorderBrush="#3B3B3B" BorderThickness="1" Margin="24,0,24,22" MinHeight="60" Padding="10,10">
        <Border.Transitions><Transitions><BrushTransition Property="BorderBrush" Duration="0:0:0.12" /></Transitions></Border.Transitions>
        <Grid ColumnDefinitions="30,*,30,1,30" ColumnSpacing="9">
          <Button Classes="icon" Command="{Binding Unavailable}" ToolTip.Tip="{i18n:T AddAttachment}" AutomationProperties.Name="{i18n:T AddAttachment}"><PathIcon Data="{StaticResource IconAdd}" Width="20" Height="20" /></Button>
          <TextBox x:Name="Composer" Grid.Column="1" Classes="composer" Text="{Binding Draft}" PlaceholderText="{Binding ComposerPlaceholder}" VerticalAlignment="Center" TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="132" MaxLength="4000" IsEnabled="{Binding HasChannel}" AutomationProperties.Name="{i18n:T MessageInput}">
            <TextBox.KeyBindings><KeyBinding Gesture="Enter" Command="{Binding Send}" /></TextBox.KeyBindings>
          </TextBox>
          <Button Grid.Column="2" Classes="icon" Command="{Binding Unavailable}" ToolTip.Tip="{i18n:T Emoji}" AutomationProperties.Name="{i18n:T Emoji}"><PathIcon Data="{StaticResource IconEmoji}" Width="19" Height="19" /></Button>
          <Border Grid.Column="3" Background="{DynamicResource DividerBrush}" Margin="0,7" />
          <Button Grid.Column="4" Classes="icon send" Command="{Binding Send}" IsEnabled="{Binding CanAttemptSend}" ToolTip.Tip="{i18n:T Send}" AutomationProperties.Name="{i18n:T Send}"><PathIcon Data="{StaticResource IconSendFilled}" Width="18" Height="18" /></Button>
        </Grid>
      </Border>
    </Grid>
    <Border Grid.Column="1" Width="300" IsVisible="{Binding MembersVisible}">
      <vm:MemberSidebar />
    </Border>
  </Grid>
</UserControl>
