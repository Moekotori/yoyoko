<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:Chat.UI.Shell" xmlns:instances="using:Chat.UI.Instances" xmlns:channels="using:Chat.UI.Channels"
  xmlns:chat="using:Chat.UI.Chat" xmlns:voice="using:Chat.UI.Voice"
  xmlns:motion="clr-namespace:Chat.Motion;assembly=Chat.Motion" xmlns:settings="using:Chat.UI.Settings"
  xmlns:appearance="using:Chat.UI.Appearance" xmlns:auth="using:Chat.UI.Auth" xmlns:i18n="using:Chat.UI.Localization"
  xmlns:chrome="using:Avalonia.Controls.Chrome"
  x:Class="Chat.UI.Shell.ShellSurface" x:DataType="vm:ShellViewModel"
>
  <UserControl.Styles>
    <StyleInclude Source="avares://Chat.UI/Shell/ShellMotion.axaml" />
  </UserControl.Styles>
  <Panel>
  <appearance:WallpaperView DataContext="{Binding Wallpaper}" />
  <Grid ColumnDefinitions="64,Auto,*" RowDefinitions="42,*,66" IsHitTestVisible="{Binding !ProfileOpen}">
    <Border Grid.ColumnSpan="3" Background="{DynamicResource ChromeBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1"
      chrome:WindowDecorationProperties.ElementRole="TitleBar" />
    <Border Grid.ColumnSpan="3" Classes="communityTitle" Classes.collapsed="{Binding ShowSettings}" Classes.motion="{Binding !ReduceMotion}"
      HorizontalAlignment="Left" Background="{DynamicResource ChromeBrush}" Padding="92,0,14,0"
      chrome:WindowDecorationProperties.ElementRole="TitleBar" IsHitTestVisible="{Binding !ShowSettings}">
      <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" ToolTip.Tip="{Binding InstanceHost}">
        <Grid ColumnDefinitions="*,16" ColumnSpacing="8"><TextBlock Text="{Binding InstanceName}" FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" /><PathIcon Grid.Column="1" Data="{StaticResource IconChevronDown}" Width="12" Height="12" /></Grid>
        <Button.Flyout>
          <Flyout Placement="BottomEdgeAlignedLeft" FlyoutPresenterClasses="communityFlyout">
            <channels:CommunityMenu DataContext="{Binding}" />
          </Flyout>
        </Button.Flyout>
      </Button>
    </Border>
    <Grid Grid.Column="2" ColumnDefinitions="*,Auto" Margin="{OnPlatform Default='0,0,112,0', macOS='0'}" IsVisible="{Binding !ShowSettings}">
      <channels:LiveChannelTabs />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" Margin="8,0,12,0" VerticalAlignment="Center" IsVisible="{Binding ShowChat}">
        <Button Classes="icon" Classes.active="{Binding SearchOpen}" Command="{Binding ToggleSearch}" ToolTip.Tip="{Binding SearchShortcutTip}" AutomationProperties.Name="{i18n:T SearchMessages}"><PathIcon Data="{StaticResource IconSearch}" /></Button>
        <Button Classes="icon" Classes.active="{Binding ParticipantsOpen}" Command="{Binding ToggleParticipants}" ToolTip.Tip="{Binding MembersShortcutTip}" AutomationProperties.Name="{i18n:T ToggleMembers}"><PathIcon Data="{StaticResource IconPeople}" /></Button>
      </StackPanel>
    </Grid>
    <instances:InstanceRail Grid.Row="1" Grid.RowSpan="2" />
    <Border Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" Classes="channelSlot" Classes.collapsed="{Binding ShowSettings}"
      Classes.motion="{Binding !ReduceMotion}" IsHitTestVisible="{Binding !ShowSettings}">
      <Grid Width="236" HorizontalAlignment="Left" RowDefinitions="*,Auto">
        <channels:ChannelSidebar />
        <StackPanel Grid.Row="1">
          <voice:VoiceSessionBar IsVisible="{Binding InVoice}" />
          <chat:LiveAccountBar />
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="1" Grid.RowSpan="2" Grid.Column="2" RowDefinitions="Auto,*" IsVisible="{Binding !ShowSettings}">
      <Border Height="52" IsVisible="{Binding !ShowChat}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="24,0,18,0">
        <TextBlock Text="{Binding PaneTitle}" VerticalAlignment="Center" FontSize="15" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
      </Border>
      <Panel Grid.Row="1">
        <motion:MotionHost IsVisible="{Binding ShowAuth}">
          <Panel>
          <Panel IsVisible="{Binding ShowAuthForm}">
            <auth:AuthView DataContext="{Binding AuthForm}" />
            <Button Content="{i18n:T BackToLocalConnection}" Command="{Binding CloseLocalAccountForm}"
              IsVisible="{Binding !AuthForm.AllowRegistration}" HorizontalAlignment="Left" VerticalAlignment="Top"
              Margin="24" />
          </Panel>
          <StackPanel MaxWidth="400" Margin="32" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="18"
            IsVisible="{Binding ShowLocalConnection}">
            <TextBlock Text="{i18n:T LocalConnectionTitle}" FontSize="21" FontWeight="SemiBold"
              HorizontalAlignment="Center" />
            <TextBlock Text="{Binding Connection.Status}" Classes="muted" FontSize="15" TextWrapping="Wrap"
              TextAlignment="Center" HorizontalAlignment="Center" IsVisible="{Binding Connection.HasStatus}" />
            <TextBlock Text="{Binding AuthForm.Status}" Classes="muted" FontSize="15" TextWrapping="Wrap"
              TextAlignment="Center" HorizontalAlignment="Center" IsVisible="{Binding !Connection.HasStatus}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
              <Button Classes="primary" Content="{i18n:T RetryLocalConnection}" Command="{Binding Connection.Connect}"
                IsEnabled="{Binding !Connection.IsBusy}" MinWidth="92" Height="38" CornerRadius="2" />
              <Button Content="{i18n:T UseExistingAccount}" Command="{Binding OpenLocalAccountForm}"
                MinWidth="82" Height="38" Background="{DynamicResource RaisedBrush}" CornerRadius="2" />
            </StackPanel>
          </StackPanel>
          <StackPanel MaxWidth="400" Margin="32" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="18"
            IsVisible="{Binding ShowConnectPrompt}">
            <TextBlock Text="{i18n:T ConnectCommunity}" FontSize="21" FontWeight="SemiBold"
              HorizontalAlignment="Center" IsVisible="{Binding !Connection.HasStatus}" />
            <TextBlock Text="{Binding Connection.Status}" Classes="muted" FontSize="15" TextWrapping="Wrap"
              TextAlignment="Center" HorizontalAlignment="Center" IsVisible="{Binding Connection.HasStatus}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
              <Button Classes="primary" Content="{i18n:T ConnectServer}" Command="{Binding Connection.Connect}"
                IsEnabled="{Binding !Connection.IsBusy}" MinWidth="92" Height="38" CornerRadius="2" />
              <Button Content="{i18n:T CancelConnection}" Command="{Binding Connection.Cancel}"
                IsVisible="{Binding Connection.ShowCancel}" IsEnabled="{Binding Connection.CanCancel}"
                MinWidth="82" Height="38" Background="{DynamicResource RaisedBrush}" CornerRadius="2" />
              <Button Content="{i18n:T Settings}" Command="{Binding OpenSettings}" MinWidth="82" Height="38"
                Background="{DynamicResource RaisedBrush}" CornerRadius="2" />
            </StackPanel>
          </StackPanel>
          </Panel>
        </motion:MotionHost>
        <chat:ChatView IsVisible="{Binding ShowChat}" />
        <TextBlock Text="{i18n:T SelectChannel}" Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding ShowChannelEmpty}" />
      </Panel>
    </Grid>
    <motion:MotionHost Grid.Row="1" Grid.RowSpan="2" Grid.Column="2" IsVisible="{Binding ShowSettings}"
      Preset="SlideLeft" StartOpacity="0.88" Duration="0:0:0.16">
      <settings:SettingsView DataContext="{Binding Settings}" />
    </motion:MotionHost>
    <Border Grid.Row="1" Grid.RowSpan="2" Grid.Column="2" IsVisible="{Binding Workspace.HasNotice}" Background="{DynamicResource SubtleBrush}" BorderBrush="{DynamicResource FocusBrush}" BorderThickness="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="20,0,20,106" CornerRadius="8" Padding="14,6" MinWidth="280">
      <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Workspace.Notice}" VerticalAlignment="Center" FontSize="13" /><Button Grid.Column="1" Classes="icon" Command="{Binding Workspace.DismissNotice}" AutomationProperties.Name="{i18n:T CloseNotice}"><PathIcon Data="{StaticResource IconClose}" Width="14" Height="14" /></Button></Grid>
    </Border>
  </Grid>
  <chat:ProfileDrawer ZIndex="20" />
  <Panel IsVisible="{Binding SwitcherOpen}" ZIndex="10">
    <Border Background="#59000000" PointerPressed="OnJumpBackdrop" />
    <channels:QuickSwitcher HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,56,0,0" />
  </Panel>

  <Panel IsVisible="{Binding ShowAddInstance}" ZIndex="30">
    <Border Background="#B9000000" PointerPressed="OnAddInstanceBackdrop" />
    <Border Width="420" MaxWidth="420" Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center"
      Background="{DynamicResource PopupBrush}" BorderBrush="{DynamicResource DividerBrush}"
      BorderThickness="1" CornerRadius="2">
      <instances:AddInstanceView />
    </Border>
  </Panel>

  <Panel IsVisible="{Binding ShowVoiceChannelSettings}" ZIndex="31">
    <Border Background="#B9000000" PointerPressed="OnVoiceChannelSettingsBackdrop" />
    <Border Width="440" MaxWidth="440" Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center"
      Background="{DynamicResource PopupBrush}" BorderBrush="{DynamicResource DividerBrush}"
      BorderThickness="1" CornerRadius="2">
      <channels:VoiceChannelSettingsView DataContext="{Binding VoiceChannelSettings}" />
    </Border>
  </Panel>

  </Panel>
</UserControl>
