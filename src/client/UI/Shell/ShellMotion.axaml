<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Border.channelSlot">
    <Setter Property="Width" Value="260" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Border.channelSlot.motion">
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Width" Duration="0:0:0.16" Easing="CubicEaseOut" />
        <DoubleTransition Property="Opacity" Duration="0:0:0.16" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.channelSlot.collapsed">
    <Setter Property="Width" Value="0" />
    <Setter Property="Opacity" Value="0" />
  </Style>
  <Style Selector="Border.communityTitle">
    <Setter Property="Width" Value="332" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Border.communityTitle.motion">
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Width" Duration="0:0:0.16" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.communityTitle.collapsed">
    <Setter Property="Width" Value="0" />
  </Style>
</Styles>
