<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:Chat.UI.Auth" xmlns:i18n="using:Chat.UI.Localization"
  x:Class="Chat.UI.Auth.AuthView" x:DataType="vm:AuthFormViewModel">
  <UserControl.Styles>
    <Style Selector="Button.authTab">
      <Setter Property="Height" Value="44" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Button.authTab.selected">
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Background" Value="{DynamicResource SelectedBrush}" />
    </Style>
    <Style Selector="TextBox.authField">
      <Setter Property="Height" Value="46" />
      <Setter Property="Padding" Value="14,11" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="BorderBrush" Value="#424242" />
      <Setter Property="PlaceholderForeground" Value="{DynamicResource QuietTextBrush}" />
    </Style>
    <Style Selector="TextBox.authField:focus /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
    </Style>
    <Style Selector="Button.authSubmit:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#F0F0F0" />
      <Setter Property="Foreground" Value="#212121" />
    </Style>
    <Style Selector="Button.authSubmit:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#CCCCCC" />
      <Setter Property="Foreground" Value="#212121" />
    </Style>
  </UserControl.Styles>
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <Grid MaxWidth="380" Margin="0,12" VerticalAlignment="Center"
      RowDefinitions="Auto,Auto,Auto,Auto">
      <Border Grid.Row="1" Background="{DynamicResource RaisedBrush}" CornerRadius="8" Padding="4" Margin="0,0,0,26">
        <Grid ColumnDefinitions="*,*" IsEnabled="{Binding !IsBusy}">
          <Button Classes="authTab" Classes.selected="{Binding !IsRegistration}"
            Content="{i18n:T SignIn}" Command="{Binding ShowSignIn}" />
          <Button Grid.Column="1" Classes="authTab" Classes.selected="{Binding IsRegistration}"
            Content="{i18n:T Register}" Command="{Binding ShowRegistration}" />
        </Grid>
      </Border>
      <StackPanel Grid.Row="2" Spacing="20" IsEnabled="{Binding !IsBusy}">
        <StackPanel Spacing="8">
          <TextBlock Text="{i18n:T Username}" FontSize="13" />
          <TextBox Classes="authField" Text="{Binding Username}" PlaceholderText="{i18n:T Username}"
            AutomationProperties.Name="{i18n:T Username}" />
        </StackPanel>
        <StackPanel Spacing="8" IsVisible="{Binding IsRegistration}">
          <TextBlock Text="{i18n:T DisplayNameField}" FontSize="13" />
          <TextBox Classes="authField" Text="{Binding DisplayName}" PlaceholderText="{i18n:T DisplayNameField}"
            AutomationProperties.Name="{i18n:T DisplayNameField}" />
        </StackPanel>
        <StackPanel Spacing="8">
          <TextBlock Text="{i18n:T Password}" FontSize="13" />
          <TextBox Classes="authField" Text="{Binding Password}" PasswordChar="•" KeyDown="OnPasswordKeyDown"
            AutomationProperties.Name="{i18n:T Password}" />
        </StackPanel>
      </StackPanel>
      <StackPanel Grid.Row="3" Spacing="14" Margin="0,28,0,0">
        <Button Classes="primary authSubmit" Height="46" HorizontalAlignment="Stretch"
          FontWeight="SemiBold" Command="{Binding Submit}">
          <Panel>
            <TextBlock Text="{i18n:T SignIn}" IsVisible="{Binding !IsRegistration}" />
            <TextBlock Text="{i18n:T Register}" IsVisible="{Binding IsRegistration}" />
          </Panel>
        </Button>
        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Classes="muted" MinHeight="20" FontSize="13" />
      </StackPanel>
    </Grid>
  </ScrollViewer>
</UserControl>
