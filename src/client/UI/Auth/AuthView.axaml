<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:Chat.UI.Shell" xmlns:i18n="using:Chat.UI.Localization"
  x:Class="Chat.UI.Auth.AuthView" x:DataType="vm:ShellViewModel">
  <UserControl.Styles>
    <Style Selector="Button.authTab">
      <Setter Property="Height" Value="44" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="Button.authTab.selected">
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,2" />
    </Style>
    <Style Selector="TextBox.authField">
      <Setter Property="Height" Value="46" />
      <Setter Property="Padding" Value="14,11" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="BorderBrush" Value="#424242" />
      <Setter Property="PlaceholderForeground" Value="{StaticResource QuietTextBrush}" />
    </Style>
    <Style Selector="TextBox.authField:focus /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
    </Style>
    <Style Selector="Button.authSubmit:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#F0F0F0" />
      <Setter Property="Foreground" Value="#212121" />
    </Style>
    <Style Selector="Button.authSubmit:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#CCCCCC" />
      <Setter Property="Foreground" Value="#212121" />
    </Style>
  </UserControl.Styles>
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <Grid MaxWidth="380" MinHeight="456" Margin="36,40" VerticalAlignment="Center"
      RowDefinitions="Auto,Auto,Auto,Auto">
      <StackPanel Spacing="10" Margin="0,0,0,26">
        <TextBlock Text="{Binding InstanceName}" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Text="{Binding InstanceHost}" Classes="muted" FontSize="14" TextWrapping="Wrap" />
      </StackPanel>
      <Border Grid.Row="1" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,26">
        <Grid ColumnDefinitions="*,*" IsEnabled="{Binding !AuthForm.IsBusy}">
          <Button Classes="authTab" Classes.selected="{Binding !AuthForm.IsRegistration}"
            Content="{i18n:T SignIn}" Command="{Binding AuthForm.ShowSignIn}" />
          <Button Grid.Column="1" Classes="authTab" Classes.selected="{Binding AuthForm.IsRegistration}"
            Content="{i18n:T Register}" Command="{Binding AuthForm.ShowRegistration}" />
        </Grid>
      </Border>
      <StackPanel Grid.Row="2" Spacing="20" IsEnabled="{Binding !AuthForm.IsBusy}">
        <StackPanel Spacing="8">
          <TextBlock Text="{i18n:T Username}" FontSize="13" />
          <TextBox Classes="authField" Text="{Binding Username}" PlaceholderText="{i18n:T Username}"
            AutomationProperties.Name="{i18n:T Username}" />
        </StackPanel>
        <StackPanel Spacing="8" IsVisible="{Binding AuthForm.IsRegistration}">
          <TextBlock Text="{i18n:T DisplayNameField}" FontSize="13" />
          <TextBox Classes="authField" Text="{Binding DisplayName}" PlaceholderText="{i18n:T DisplayNameField}"
            AutomationProperties.Name="{i18n:T DisplayNameField}" />
        </StackPanel>
        <StackPanel Spacing="8">
          <TextBlock Text="{i18n:T Password}" FontSize="13" />
          <TextBox Classes="authField" Text="{Binding Password}" PasswordChar="•" KeyDown="OnPasswordKeyDown"
            AutomationProperties.Name="{i18n:T Password}" />
        </StackPanel>
      </StackPanel>
      <StackPanel Grid.Row="3" Spacing="14" Margin="0,28,0,0">
        <Button Classes="primary authSubmit" Height="46" HorizontalAlignment="Stretch"
          FontWeight="SemiBold" Command="{Binding AuthForm.Submit}">
          <Panel>
            <TextBlock Text="{i18n:T SignIn}" IsVisible="{Binding !AuthForm.IsRegistration}" />
            <TextBlock Text="{i18n:T Register}" IsVisible="{Binding AuthForm.IsRegistration}" />
          </Panel>
        </Button>
        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Classes="muted" MinHeight="20" FontSize="13" />
      </StackPanel>
    </Grid>
  </ScrollViewer>
</UserControl>
