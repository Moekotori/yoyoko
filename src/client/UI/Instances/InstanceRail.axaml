<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:Chat.UI.Shell" xmlns:items="using:Chat.UI.Instances" xmlns:i18n="using:Chat.UI.Localization" xmlns:c="using:Chat.UI.Components"
  x:Class="Chat.UI.Instances.InstanceRail" x:DataType="vm:ShellViewModel">
  <UserControl.Styles>
    <Style Selector="ListBoxItem"><Setter Property="Padding" Value="4" /><Setter Property="Margin" Value="0,0,0,8" /><Setter Property="CornerRadius" Value="2" /></Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#2C2C2C" /><Setter Property="BorderThickness" Value="0" /></Style>
    <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#303030" /></Style>
    <Style Selector="c|Avatar.railAvatar Ellipse.avatarOutline"><Setter Property="IsVisible" Value="False" /></Style>
  </UserControl.Styles>
  <Border Background="{DynamicResource RailBrush}">
    <Grid RowDefinitions="*,66">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,14" Spacing="10">
          <ListBox ItemsSource="{Binding Instances}" SelectedItem="{Binding SelectedInstance}" Margin="8,0"
            AutomationProperties.Name="{i18n:T Instances}" PointerPressed="OnInstancePressed">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="items:InstanceItem">
                <Panel Width="42" Height="42">
                  <c:Avatar Classes="railAvatar" Width="42" Height="42" Playback="{Binding Playback}" Initial="{Binding Initial}" ToolTip.Tip="{Binding Host}" />
                  <Border Width="8" Height="8" CornerRadius="4" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-6,0,0,0"
                    Background="#E8E8E8" IsVisible="{Binding HasUnread}" />
                  <Border Width="8" Height="8" CornerRadius="4" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-1,-1"
                    Background="#C45C56" IsVisible="{Binding HasMention}" />
                </Panel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Button Width="40" Height="40" CornerRadius="20" Background="#292929" Foreground="{DynamicResource MutedTextBrush}"
            HorizontalAlignment="Center" Command="{Binding OpenAddInstance}"
            AutomationProperties.Name="{i18n:T AddInstance}" ToolTip.Tip="{i18n:T AddInstance}">
            <PathIcon Data="{StaticResource IconAdd}" Width="20" Height="20" />
          </Button>
        </StackPanel>
      </ScrollViewer>
      <Button Grid.Row="1" Classes="icon" Classes.active="{Binding ShowSettings}"
        Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center"
        Command="{Binding OpenSettings}" ToolTip.Tip="{Binding SettingsShortcutTip}" AutomationProperties.Name="{i18n:T Settings}">
        <PathIcon Data="{StaticResource IconSettings}" Width="20" Height="20" />
      </Button>
    </Grid>
  </Border>
</UserControl>
