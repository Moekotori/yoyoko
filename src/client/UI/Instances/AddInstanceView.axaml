<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:Chat.UI.Shell" xmlns:i18n="using:Chat.UI.Localization"
  x:Class="Chat.UI.Instances.AddInstanceView" x:DataType="vm:ShellViewModel">
  <StackPanel MaxWidth="480" Margin="40" Spacing="18" VerticalAlignment="Center" HorizontalAlignment="Center">
    <TextBlock Text="{i18n:T ConnectCommunity}" FontSize="30" FontWeight="SemiBold" />
    <TextBlock Text="{i18n:T InstanceAddress}" FontSize="13" />
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
      <TextBox Text="{Binding Address}" PlaceholderText="{i18n:T InstanceAddressPlaceholder}"
        AutomationProperties.Name="{i18n:T InstanceAddress}" MinWidth="200">
        <TextBox.KeyBindings><KeyBinding Gesture="Enter" Command="{Binding AddInstance}" /></TextBox.KeyBindings>
      </TextBox>
      <Button Grid.Column="1" Classes="primary" Content="{i18n:T AddInstance}" Command="{Binding AddInstance}" />
    </Grid>
    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Classes="muted" MinHeight="40"
      AutomationProperties.Name="{i18n:T ActionStatus}" />
  </StackPanel>
</UserControl>
