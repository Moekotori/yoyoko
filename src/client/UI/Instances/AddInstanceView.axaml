<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:Chat.UI.Shell" xmlns:i18n="using:Chat.UI.Localization"
  x:Class="Chat.UI.Instances.AddInstanceView" x:DataType="vm:ShellViewModel">
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding CloseAddInstance}" />
  </UserControl.KeyBindings>
  <StackPanel Spacing="20" Margin="24">
    <Grid ColumnDefinitions="*,Auto">
      <TextBlock Text="{i18n:T AddInstance}" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" />
      <Button Grid.Column="1" Classes="icon" Command="{Binding CloseAddInstance}"
        AutomationProperties.Name="{i18n:T CloseAddInstance}">
        <PathIcon Data="{StaticResource IconClose}" Width="16" Height="16" />
      </Button>
    </Grid>
    <StackPanel Spacing="14" IsEnabled="{Binding !IsAddingInstance}">
      <StackPanel Spacing="8">
        <TextBlock Text="{i18n:T InstanceAddress}" FontSize="13" />
        <TextBox x:Name="AddressInput" Text="{Binding AddAddress}" PlaceholderText="{i18n:T InstanceAddressPlaceholder}"
          Height="40" Padding="12,8" VerticalContentAlignment="Center" AutomationProperties.Name="{i18n:T InstanceAddress}">
          <TextBox.KeyBindings><KeyBinding Gesture="Enter" Command="{Binding AddInstance}" /></TextBox.KeyBindings>
        </TextBox>
      </StackPanel>
      <StackPanel Spacing="8">
        <TextBlock Text="{i18n:T OptionalServerPassword}" FontSize="13" />
        <TextBox Text="{Binding AddServerPassword}" PasswordChar="•" MaxLength="128"
          Height="40" Padding="12,8" VerticalContentAlignment="Center"
          AutomationProperties.Name="{i18n:T OptionalServerPassword}">
          <TextBox.KeyBindings><KeyBinding Gesture="Enter" Command="{Binding AddInstance}" /></TextBox.KeyBindings>
        </TextBox>
      </StackPanel>
    </StackPanel>
    <TextBlock Text="{Binding AddInstanceStatus}" TextWrapping="Wrap" Classes="muted" FontSize="13"
      AutomationProperties.Name="{i18n:T ActionStatus}" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
      <Button Content="{i18n:T CancelConnection}" Command="{Binding CloseAddInstance}" MinWidth="82" />
      <Button Classes="primary" Content="{i18n:T AddInstance}" Command="{Binding AddInstance}"
        IsEnabled="{Binding !IsAddingInstance}" MinWidth="104" />
    </StackPanel>
  </StackPanel>
</UserControl>
