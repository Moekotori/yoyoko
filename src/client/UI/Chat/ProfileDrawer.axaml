<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="using:Chat.UI.Shell" xmlns:i18n="using:Chat.UI.Localization" xmlns:c="using:Chat.UI.Components"
 x:Class="Chat.UI.Chat.ProfileDrawer" x:DataType="vm:ShellViewModel"
 Classes="profileDrawer" IsVisible="False" IsHitTestVisible="{Binding ProfileOpen}">
  <UserControl.Styles>
    <Style Selector="Border#DrawerSurface"><Setter Property="Opacity" Value="0" /><Setter Property="RenderTransform" Value="translate(0px, 10px)" /></Style>
    <Style Selector=".profileDrawer.motion Border#DrawerSurface">
      <Setter Property="Transitions"><Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.16" Easing="CubicEaseOut" /><TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut" /></Transitions></Setter>
    </Style>
    <Style Selector=".profileDrawer.open Border#DrawerSurface"><Setter Property="Opacity" Value="1" /><Setter Property="RenderTransform" Value="translate(0px, 0px)" /></Style>
    <Style Selector="TextBox.cardField">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Height" Value="34" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.cardAction">
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.cardSave">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.avatarHit">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="34" />
    </Style>
  </UserControl.Styles>
  <Panel>
    <Border Background="Transparent" PointerPressed="OnBackdrop" />
    <Border x:Name="DrawerSurface" Width="300" HorizontalAlignment="Left" VerticalAlignment="Bottom"
      Margin="80,0,0,78" Background="#242424" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="12"
      ClipToBounds="True" IsEnabled="{Binding ProfileOpen}" KeyboardNavigation.TabNavigation="Cycle">
      <StackPanel>
        <Panel Height="104">
          <Border Height="68" VerticalAlignment="Top" Background="#1A1A1A" />
          <Button Classes="icon" Width="28" Height="28" Margin="0,8,8,0" HorizontalAlignment="Right" VerticalAlignment="Top"
            Command="{Binding CloseProfile}" ToolTip.Tip="{i18n:T CloseProfile}" AutomationProperties.Name="{i18n:T CloseProfile}">
            <PathIcon Data="{StaticResource IconClose}" Width="12" Height="12" />
          </Button>
          <Border Width="80" Height="80" CornerRadius="40" Background="#242424" Margin="14,32,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Button Classes="avatarHit" Width="68" Height="68" HorizontalAlignment="Center" VerticalAlignment="Center"
              Command="{Binding Settings.Profile.ChangeAvatar}" ToolTip.Tip="{i18n:T ChangeAvatar}" AutomationProperties.Name="{i18n:T ChangeAvatar}">
              <c:Avatar Width="68" Height="68" Playback="{Binding Settings.Profile.Playback}" Initial="{Binding Settings.Profile.Initial}" />
            </Button>
          </Border>
        </Panel>
        <Border Margin="12,0,12,12" Background="#1C1C1C" CornerRadius="8" Padding="12">
          <StackPanel Spacing="10">
            <StackPanel Spacing="2">
              <TextBlock Text="{Binding Settings.Profile.DisplayName}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <SelectableTextBlock Text="{Binding Settings.Profile.Handle}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" IsVisible="{Binding Settings.Profile.HasHandle}" />
            </StackPanel>
            <Border Height="1" Background="#2E2E2E" />
            <StackPanel Spacing="4">
              <TextBlock Text="{i18n:T UserId}" Classes="section" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                <SelectableTextBlock Text="{Binding Settings.Profile.IdText}" FontSize="11" FontFamily="Menlo, Consolas, monospace" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="icon" Width="26" Height="26" Padding="5" Click="CopyId"
                  ToolTip.Tip="{i18n:T CopyUserId}" AutomationProperties.Name="{i18n:T CopyUserId}">
                  <PathIcon Data="{StaticResource IconCopy}" Width="13" Height="13" />
                </Button>
              </Grid>
            </StackPanel>
            <StackPanel Spacing="4">
              <TextBlock Text="{i18n:T DisplayNameField}" Classes="section" />
              <TextBox x:Name="DisplayNameField" Classes="cardField" Text="{Binding Settings.Profile.DisplayName}" MaxLength="64" AutomationProperties.Name="{i18n:T DisplayNameField}" />
            </StackPanel>
            <StackPanel Spacing="4">
              <TextBlock Text="{i18n:T Username}" Classes="section" />
              <TextBox Classes="cardField" Text="{Binding Settings.Profile.Username}" MaxLength="32" AutomationProperties.Name="{i18n:T Username}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button Classes="cardAction" Content="{i18n:T ChangeAvatar}" Command="{Binding Settings.Profile.ChangeAvatar}" />
              <Button Classes="cardAction" Content="{i18n:T RemoveAvatar}" Command="{Binding Settings.Profile.RemoveAvatar}" IsVisible="{Binding Settings.Profile.HasAvatar}" />
            </StackPanel>
            <TextBlock Text="{Binding Settings.Profile.Status}" Classes="muted" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding Settings.Profile.HasStatus}" />
            <Button Classes="primary cardSave" Content="{i18n:T SaveProfile}" Command="{Binding Settings.Profile.Save}" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>
  </Panel>
</UserControl>
