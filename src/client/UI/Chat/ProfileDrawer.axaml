<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="using:Chat.UI.Shell" xmlns:i18n="using:Chat.UI.Localization" xmlns:c="using:Chat.UI.Components"
 x:Class="Chat.UI.Chat.ProfileDrawer" x:DataType="vm:ShellViewModel"
 IsVisible="False" IsHitTestVisible="{Binding ProfileOpen}">
  <UserControl.Styles>
    <Style Selector="Border#DrawerSurface"><Setter Property="Opacity" Value="0" /><Setter Property="RenderTransform" Value="translate(-32px, 0px)" /></Style>
    <Style Selector="Border#DrawerBackdrop"><Setter Property="Opacity" Value="0" /></Style>
    <Style Selector="UserControl.motion Border#DrawerSurface">
      <Setter Property="Transitions"><Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseOut" /><TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="CubicEaseOut" /></Transitions></Setter>
    </Style>
    <Style Selector="UserControl.motion Border#DrawerBackdrop"><Setter Property="Transitions"><Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.18" /></Transitions></Setter></Style>
    <Style Selector="UserControl.open Border#DrawerSurface"><Setter Property="Opacity" Value="1" /><Setter Property="RenderTransform" Value="translate(0px, 0px)" /></Style>
    <Style Selector="UserControl.open Border#DrawerBackdrop"><Setter Property="Opacity" Value="1" /></Style>
    <Style Selector="TextBox"><Setter Property="CornerRadius" Value="2" /><Setter Property="MinHeight" Value="40" /></Style>
    <Style Selector="Button"><Setter Property="CornerRadius" Value="2" /></Style>
  </UserControl.Styles>
  <Panel>
    <Border x:Name="DrawerBackdrop" Background="#66000000" PointerPressed="OnBackdrop" />
    <Border x:Name="DrawerSurface" Width="380" HorizontalAlignment="Left" Margin="72,42,0,66" Background="{StaticResource ChromeBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,1,1" IsEnabled="{Binding ProfileOpen}" KeyboardNavigation.TabNavigation="Cycle">
      <Grid RowDefinitions="64,*,Auto">
        <Grid ColumnDefinitions="*,Auto" Margin="24,0,18,0">
          <TextBlock Text="{i18n:T Profile}" FontSize="18" FontWeight="Medium" VerticalAlignment="Center" />
          <Button Grid.Column="1" Classes="icon" Command="{Binding CloseProfile}" AutomationProperties.Name="{i18n:T CloseProfile}" ToolTip.Tip="{i18n:T CloseProfile}"><PathIcon Data="{StaticResource IconClose}" Width="16" Height="16" /></Button>
        </Grid>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="24,16,24,24" Spacing="24">
            <StackPanel Spacing="14">
              <c:Avatar Width="72" Height="72" HorizontalAlignment="Left" Playback="{Binding Settings.Profile.Playback}" Initial="{Binding Settings.Profile.Initial}" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="{i18n:T ChangeAvatar}" Command="{Binding Settings.Profile.ChangeAvatar}" />
                <Button Content="{i18n:T RemoveAvatar}" Command="{Binding Settings.Profile.RemoveAvatar}" IsVisible="{Binding Settings.Profile.HasAvatar}" />
              </StackPanel>
            </StackPanel>
            <StackPanel Spacing="10">
              <TextBlock Text="{i18n:T DisplayNameField}" />
              <TextBox x:Name="DisplayNameField" Text="{Binding Settings.Profile.DisplayName}" MaxLength="64" AutomationProperties.Name="{i18n:T DisplayNameField}" />
            </StackPanel>
            <StackPanel Spacing="10">
              <TextBlock Text="{i18n:T Username}" />
              <TextBox Text="{Binding Settings.Profile.Username}" MaxLength="32" AutomationProperties.Name="{i18n:T Username}" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Margin="24,16,24,24" Spacing="14">
          <TextBlock Text="{Binding Settings.Profile.Status}" TextWrapping="Wrap" IsVisible="{Binding Settings.Profile.HasStatus}" />
          <Button Classes="primary" Content="{i18n:T SaveProfile}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding Settings.Profile.Save}" />
        </StackPanel>
      </Grid>
    </Border>
  </Panel>
</UserControl>
