<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:chat="using:Chat.UI.Chat" xmlns:c="using:Chat.UI.Components" xmlns:i18n="using:Chat.UI.Localization"
  x:Class="Chat.UI.Chat.UserCard" x:DataType="chat:MemberProfile">
  <Border Width="300" VerticalAlignment="Top" Background="#242424" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
    <StackPanel>
      <Panel Height="104">
        <Border Height="68" VerticalAlignment="Top" Background="#1A1A1A" />
        <Border Width="80" Height="80" CornerRadius="40" Background="#242424" Margin="14,32,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
          <c:Avatar Width="68" Height="68" HorizontalAlignment="Center" VerticalAlignment="Center"
            Playback="{Binding Playback}" Source="{Binding Image}" Initial="{Binding Initial}" />
        </Border>
      </Panel>
      <Border Margin="12,0,12,12" Background="#1C1C1C" CornerRadius="8" Padding="12">
        <StackPanel Spacing="10">
          <StackPanel Spacing="2">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{i18n:T You}" Classes="quiet" FontSize="11" VerticalAlignment="Center" IsVisible="{Binding IsSelf}" />
            </StackPanel>
            <SelectableTextBlock Text="{Binding Handle}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" IsVisible="{Binding HasHandle}" />
          </StackPanel>
          <Border Height="1" Background="#2E2E2E" />
          <StackPanel Spacing="4">
            <TextBlock Text="{i18n:T UserId}" Classes="section" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
              <SelectableTextBlock Text="{Binding IdText}" FontSize="11" FontFamily="Menlo, Consolas, monospace" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              <Button Grid.Column="1" Classes="icon" Width="26" Height="26" Padding="5" Click="CopyId"
                ToolTip.Tip="{i18n:T CopyUserId}" AutomationProperties.Name="{i18n:T CopyUserId}">
                <PathIcon Data="{StaticResource IconCopy}" Width="13" Height="13" />
              </Button>
            </Grid>
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </Border>
</UserControl>
