<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:motion="clr-namespace:Chat.Motion;assembly=Chat.Motion" xmlns:vm="using:Chat.UI.Shell" xmlns:chat="using:Chat.UI.Chat" xmlns:i18n="using:Chat.UI.Localization" xmlns:c="using:Chat.UI.Components"
  x:Class="Chat.UI.Chat.ChatView" x:DataType="vm:ShellViewModel" x:Name="ChatRoot"
  Classes.compact="{Binding CompactLayout}" Classes.reduceMotion="{Binding ReduceMotion}">
  <UserControl.Styles>
    <Style Selector="ListBoxItem"><Setter Property="Padding" Value="0" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Focusable" Value="False" /></Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent" /></Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent" /></Style>
    <Style Selector="Grid.messageRow"><Setter Property="Background" Value="Transparent" /><Setter Property="Margin" Value="0,0,0,12" /></Style>
    <Style Selector="Grid.messageRow:pointerover"><Setter Property="Background" Value="#232323" /></Style>
    <Style Selector="UserControl.compact Grid.messageRow"><Setter Property="Margin" Value="0,0,0,2" /></Style>
    <Style Selector="Grid.messageRow.continued"><Setter Property="Margin" Value="0,0,0,2" /></Style>
    <Style Selector="UserControl.compact Grid.messageRow.continued"><Setter Property="Margin" Value="0" /></Style>
    <Style Selector="Grid.messageRow.continued StackPanel.body"><Setter Property="Margin" Value="0,1,0,1" /></Style>
    <Style Selector="SelectableTextBlock.messageText"><Setter Property="FontSize" Value="16" /><Setter Property="LineHeight" Value="25" /><Setter Property="Foreground" Value="#CCCCCC" /></Style>
    <Style Selector="UserControl.compact SelectableTextBlock.messageText"><Setter Property="FontSize" Value="14" /><Setter Property="LineHeight" Value="22" /></Style>
    <Style Selector="Border.messageTools"><Setter Property="IsVisible" Value="False" /></Style>
    <Style Selector="Grid.messageRow:pointerover Border.messageTools"><Setter Property="IsVisible" Value="True" /></Style>
    <Style Selector="Grid.messageRow:focus-within Border.messageTools"><Setter Property="IsVisible" Value="True" /></Style>
    <Style Selector="Button.authorName"><Setter Property="Padding" Value="0" /><Setter Property="Background" Value="Transparent" /><Setter Property="HorizontalAlignment" Value="Left" /><Setter Property="HorizontalContentAlignment" Value="Left" /><Setter Property="Cursor" Value="Hand" /></Style>
    <Style Selector="Button.authorName:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent" /></Style>
    <Style Selector="Button.avatarPick"><Setter Property="Cursor" Value="Hand" /></Style>
    <Style Selector="Grid.unreadDivider TextBlock"><Setter Property="FontSize" Value="10" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="#C98884" /></Style>
  </UserControl.Styles>
  <Grid ColumnDefinitions="*,Auto">
    <Grid RowDefinitions="Auto,*,Auto">
      <Grid ColumnDefinitions="*,30" Margin="24,12,24,0" IsVisible="{Binding SearchOpen}">
        <TextBox x:Name="SearchBox" Text="{Binding SearchQuery}" PlaceholderText="{i18n:T SearchInChannel}" AutomationProperties.Name="{i18n:T SearchContent}" />
        <Button Grid.Column="1" Classes="icon" Command="{Binding ToggleSearch}" AutomationProperties.Name="{i18n:T CloseSearch}"><PathIcon Data="{StaticResource IconClose}" Width="14" Height="14" /></Button>
      </Grid>
      <motion:MotionHost Grid.Row="1" Trigger="{Binding ChannelContentVersion}" Preset="Fade" Duration="0:0:0.12" StartOpacity="0.82">
      <Panel x:Name="TimelineSurface">
        <TextBlock Text="{Binding EmptyMessageTitle}" Classes="muted" FontSize="14" IsVisible="{Binding EmptyMessages}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        <ListBox x:Name="Messages" ItemsSource="{Binding VisibleMessages}" Margin="0,22,0,12" AutomationProperties.Name="{i18n:T Messages}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="chat:MessageRow">
              <Panel>
              <Grid Classes="unreadDivider" ColumnDefinitions="*,Auto,*" Margin="16,6,16,6" IsVisible="{Binding IsUnreadDivider}">
                <Border Height="1" Background="#5C3A38" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{i18n:T NewMessagesDivider}" Margin="8,0" />
                <Border Grid.Column="2" Height="1" Background="#5C3A38" VerticalAlignment="Center" />
              </Grid>
              <Grid Classes="messageRow" Classes.continued="{Binding IsContinuation}" ColumnDefinitions="24,36,13,*,24" IsVisible="{Binding !IsUnreadDivider}">
                <Grid.ContextMenu><ContextMenu>
                  <MenuItem Header="{i18n:T CopyText}" Click="CopyMessage" />
                  <MenuItem Header="{i18n:T MarkAsUnread}" Click="MarkUnreadFrom" />
                  <MenuItem Header="{i18n:T EditMessage}" Click="EditMessage" IsVisible="{Binding CanEdit}" />
                </ContextMenu></Grid.ContextMenu>
                <Button Grid.Column="1" Classes="avatarPick" Width="36" Height="36" Padding="0" VerticalAlignment="Top" Margin="0,12,0,0" IsVisible="{Binding ShowHeader}" AutomationProperties.Name="{Binding Author}">
                  <Button.Flyout>
                    <Flyout Placement="RightEdgeAlignedTop" FlyoutPresenterClasses="userCardFlyout" Opened="OnCardOpened">
                      <chat:UserCard />
                    </Flyout>
                  </Button.Flyout>
                  <c:Avatar Width="36" Height="36" Playback="{Binding Playback}" Initial="{Binding Initial}" />
                </Button>
                <StackPanel Grid.Column="3" Classes="body" Spacing="4" Margin="0,11,0,9">
                  <StackPanel Orientation="Horizontal" Spacing="9" IsVisible="{Binding ShowHeader}">
                    <Button Classes="authorName" Padding="0" Background="Transparent" HorizontalAlignment="Left" AutomationProperties.Name="{Binding Author}">
                      <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedLeft" FlyoutPresenterClasses="userCardFlyout" Opened="OnCardOpened">
                          <chat:UserCard />
                        </Flyout>
                      </Button.Flyout>
                      <TextBlock Text="{Binding Author}" FontSize="14" FontWeight="SemiBold" Foreground="#E2E2E2" />
                    </Button>
                    <TextBlock Text="{Binding Time}" Classes="quiet" FontSize="11" VerticalAlignment="Center" />
                    <TextBlock Text="{i18n:T Edited}" Classes="quiet" FontSize="11" VerticalAlignment="Center" IsVisible="{Binding IsEdited}" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="9" IsVisible="{Binding ShowSendState}">
                    <TextBlock Text="{i18n:T Sending}" Classes="muted" FontSize="11" IsVisible="{Binding IsPending}" />
                    <Button Padding="8,2" Command="{Binding Retry}" IsVisible="{Binding IsFailed}"
                      ToolTip.Tip="{i18n:T RetrySend}" AutomationProperties.Name="{i18n:T RetrySend}">
                      <TextBlock Text="{i18n:T SendFailed}" Foreground="#D98980" FontSize="11" />
                    </Button>
                  </StackPanel>
                  <chat:MessageText Markdown="{Binding Content}" Classes="messageText" TextWrapping="Wrap" IsVisible="{Binding HasText}" />
                  <ItemsControl ItemsSource="{Binding Files}" IsVisible="{Binding HasFiles}">
                    <ItemsControl.ItemTemplate><DataTemplate x:DataType="chat:AttachmentRow">
                      <StackPanel Spacing="4" Margin="0,6,0,0">
                        <Button HorizontalAlignment="Left" Padding="0" Background="Transparent" Command="{Binding Save}" IsVisible="{Binding HasPreview}" ToolTip.Tip="{i18n:T DownloadLocal}" AutomationProperties.Name="{i18n:T DownloadFile}">
                          <Image Source="{Binding Preview}" MaxWidth="280" MaxHeight="200" Stretch="Uniform" />
                        </Button>
                        <Button HorizontalAlignment="Left" Padding="10,6" Background="{DynamicResource RaisedBrush}" Command="{Binding Save}" IsVisible="{Binding ShowChip}" ToolTip.Tip="{i18n:T DownloadLocal}" AutomationProperties.Name="{i18n:T DownloadFile}">
                          <Panel><TextBlock Text="{Binding Label}" FontSize="13" IsVisible="{Binding !IsSaving}" /><TextBlock Text="{i18n:T Downloading}" FontSize="13" IsVisible="{Binding IsSaving}" /></Panel>
                        </Button>
                      </StackPanel>
                    </DataTemplate></ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
                <Border Grid.ColumnSpan="5" Classes="messageTools" Background="#2A2A2A" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,16,0">
                  <StackPanel Orientation="Horizontal">
                    <Button Classes="icon" Width="26" Height="26" Click="CopyMessage" AutomationProperties.Name="{i18n:T CopyMessage}" ToolTip.Tip="{i18n:T CopyText}"><PathIcon Data="{StaticResource IconCopy}" Width="14" Height="14" /></Button>
                    <Button Classes="icon" Width="26" Height="26" Click="EditMessage" IsVisible="{Binding CanEdit}" AutomationProperties.Name="{i18n:T EditMessage}" ToolTip.Tip="{i18n:T EditMessage}"><PathIcon Data="{StaticResource IconEdit}" Width="14" Height="14" /></Button>
                  </StackPanel>
                </Border>
              </Grid>
              </Panel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <Border Background="#E51C1C1C" BorderBrush="{DynamicResource FocusBrush}" BorderThickness="1" Margin="12" CornerRadius="8" IsVisible="{Binding #ChatRoot.DropActive}" IsHitTestVisible="False"><TextBlock Text="{i18n:T DropFiles}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" /></Border>
        <Button Classes="jumpPresent" Command="{Binding JumpPresent}" IsVisible="{Binding ShowJumpBar}"
          HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10"
          Content="{Binding JumpBarLabel}" AutomationProperties.Name="{Binding JumpBarLabel}" />
      </Panel>
      </motion:MotionHost>
      <StackPanel Grid.Row="2" Margin="24,0,24,22" Spacing="8">
        <TextBlock Text="{Binding Status}" Classes="muted" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding HasStatus}" />
        <ItemsControl ItemsSource="{Binding PendingFiles}" IsVisible="{Binding HasPending}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate><DataTemplate x:DataType="chat:PendingFileItem">
            <Border Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="8" Padding="8,4" Margin="0,0,6,2">
              <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="{Binding Label}" FontSize="12" VerticalAlignment="Center" /><Button Classes="icon" Width="22" Height="22" Padding="4" Command="{Binding Remove}" ToolTip.Tip="{i18n:T RemoveFile}" AutomationProperties.Name="{i18n:T RemoveFile}"><PathIcon Data="{StaticResource IconClose}" Width="10" Height="10" /></Button></StackPanel>
            </Border>
          </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border Classes="composerFrame" Classes.editing="{Binding IsEditing}" Background="{DynamicResource RaisedBrush}" BorderBrush="#3B3B3B" BorderThickness="1" MinHeight="60" Padding="8,8,8,10">
          <Border.Transitions><Transitions><BrushTransition Property="BorderBrush" Duration="0:0:0.12" /></Transitions></Border.Transitions>
          <DockPanel>
            <Grid DockPanel.Dock="Top" Height="24" Margin="4,0,4,4" IsVisible="{Binding IsEditing}">
              <TextBlock Text="{Binding ComposerEditHint}" FontSize="12" Foreground="#C4B4B2" VerticalAlignment="Center" />
              <Button Classes="icon" Width="22" Height="22" HorizontalAlignment="Right" Command="{Binding CancelComposerEdit}" ToolTip.Tip="{i18n:T CancelEdit}" AutomationProperties.Name="{i18n:T CancelEdit}"><PathIcon Data="{StaticResource IconClose}" Width="10" Height="10" /></Button>
            </Grid>
            <Grid ColumnDefinitions="30,*,30" ColumnSpacing="9">
              <Button Classes="icon" Command="{Binding AttachFile}" IsEnabled="{Binding !IsEditing}" ToolTip.Tip="{Binding AttachTip}" AutomationProperties.Name="{i18n:T AddFile}"><PathIcon Data="{StaticResource IconAdd}" Width="20" Height="20" /></Button>
              <TextBox x:Name="Composer" Grid.Column="1" Classes="composer" Text="{Binding Draft}" PlaceholderText="{Binding ComposerPlaceholder}" VerticalAlignment="Center" TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="132" MaxLength="4000" AutomationProperties.Name="{i18n:T MessageInput}" KeyDown="OnComposerKeyDown" />
              <Button Grid.Column="2" Classes="icon send" Command="{Binding Send}" IsEnabled="{Binding CanSend}" ToolTip.Tip="{Binding SendTip}" AutomationProperties.Name="{i18n:T Send}"><PathIcon Data="{StaticResource IconSendFilled}" Width="18" Height="18" /></Button>
            </Grid>
          </DockPanel>
        </Border>
      </StackPanel>
    </Grid>
    <chat:MemberSidebar Grid.Column="1" IsVisible="{Binding ParticipantsOpen}" />
  </Grid>
</UserControl>
