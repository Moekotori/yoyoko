<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:Chat.UI.Shell" xmlns:chat="using:Chat.UI.Chat" xmlns:i18n="using:Chat.UI.Localization" xmlns:c="using:Chat.UI.Components"
  x:Class="Chat.UI.Chat.MemberSidebar" x:DataType="vm:ShellViewModel">
  <UserControl.Styles>
    <Style Selector="Button.memberRow">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Padding" Value="6,5" />
      <Setter Property="Margin" Value="0,0,0,1" />
    </Style>
    <Style Selector="Button.memberRow:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#323232" />
    </Style>
  </UserControl.Styles>
  <Border Width="220" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1,0,0,0">
    <Grid RowDefinitions="52,*">
      <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="16,0">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <TextBlock Text="{i18n:T PageParticipants}" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          <TextBlock Grid.Column="1" Text="{Binding ParticipantCount}" Classes="quiet" FontSize="12" VerticalAlignment="Center" IsVisible="{Binding HasParticipants}" />
        </Grid>
      </Border>
      <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding Participants}" Margin="8,12,8,16" AutomationProperties.Name="{i18n:T PageParticipants}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="chat:MemberProfile">
              <Button Classes="memberRow" AutomationProperties.Name="{Binding Name}">
                <Button.Flyout>
                  <Flyout Placement="LeftEdgeAlignedTop" FlyoutPresenterClasses="userCardFlyout" Opened="OnCardOpened">
                    <chat:UserCard DataContext="{Binding}" />
                  </Flyout>
                </Button.Flyout>
                <Button.ContextMenu>
                  <ContextMenu DataContext="{Binding}" Opening="OnMemberMenuOpening">
                    <MenuItem Header="{i18n:T MentionMember}" />
                    <MenuItem Header="{i18n:T CopyUsername}" />
                    <MenuItem Header="{i18n:T CopyUserId}" />
                    <MenuItem Header="{i18n:T Profile}" />
                    <Separator />
                    <MenuItem Header="{i18n:T KickMember}" Foreground="#E3A09A" />
                    <MenuItem Header="{i18n:T BanMember}" Foreground="#E3A09A" />
                  </ContextMenu>
                </Button.ContextMenu>
                <Grid ColumnDefinitions="32,*" ColumnSpacing="8">
                  <c:Avatar Width="32" Height="32" Playback="{Binding Playback}" Source="{Binding Image}" Initial="{Binding Initial}" />
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Handle}" Classes="quiet" FontSize="11" IsVisible="{Binding HasHandle}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>
  </Border>
</UserControl>
