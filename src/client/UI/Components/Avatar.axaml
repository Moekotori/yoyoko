<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Chat.UI.Components"
  x:Class="Chat.UI.Components.Avatar" x:DataType="local:Avatar" x:Name="Root">
  <UserControl.Styles>
    <Style Selector="Ellipse.avatarOutline.speaking">
      <Setter Property="Stroke" Value="{DynamicResource SuccessBrush}" />
      <Setter Property="StrokeThickness" Value="2" />
    </Style>
  </UserControl.Styles>
  <Grid>
    <Ellipse Fill="{DynamicResource AvatarBrush}" />
    <Viewbox Margin="7" Stretch="Uniform" IsHitTestVisible="False" IsVisible="{Binding !HasImage, ElementName=Root}">
      <TextBlock Text="{Binding Initial, ElementName=Root}" FontWeight="SemiBold" Foreground="{DynamicResource StrongTextBrush}" />
    </Viewbox>
    <Ellipse IsVisible="{Binding HasImage, ElementName=Root}"><Ellipse.Fill><ImageBrush Source="{Binding Source, ElementName=Root}" Stretch="UniformToFill" /></Ellipse.Fill></Ellipse>
    <Ellipse Classes="avatarOutline" Classes.speaking="{Binding Speaking, ElementName=Root}" Stroke="{DynamicResource AvatarOutlineBrush}" StrokeThickness="1" IsHitTestVisible="False" />
    <Ellipse Width="10" Height="10" Fill="{DynamicResource SuccessBrush}" Stroke="{DynamicResource CanvasBrush}" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" IsVisible="{Binding IsOnline, ElementName=Root}" />
  </Grid>
</UserControl>
