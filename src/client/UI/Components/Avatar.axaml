<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Chat.UI.Components"
  x:Class="Chat.UI.Components.Avatar" x:DataType="local:Avatar" x:Name="Root">
  <Grid>
    <Ellipse Fill="#3A3A3A" />
    <Viewbox Margin="7" Stretch="Uniform" IsHitTestVisible="False" IsVisible="{Binding !HasImage, ElementName=Root}">
      <TextBlock Text="{Binding Initial, ElementName=Root}" FontWeight="SemiBold" Foreground="#E8E8E8" />
    </Viewbox>
    <Ellipse IsVisible="{Binding HasImage, ElementName=Root}"><Ellipse.Fill><ImageBrush Source="{Binding Source, ElementName=Root}" Stretch="UniformToFill" /></Ellipse.Fill></Ellipse>
    <Ellipse Stroke="#18FFFFFF" StrokeThickness="1" IsHitTestVisible="False" />
    <Ellipse Width="10" Height="10" Fill="#3FA267" Stroke="{StaticResource SidebarBrush}" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" IsVisible="{Binding IsOnline, ElementName=Root}" />
  </Grid>
</UserControl>
