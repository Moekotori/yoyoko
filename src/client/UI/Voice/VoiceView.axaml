<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:Chat.UI.Shell" xmlns:i18n="using:Chat.UI.Localization" xmlns:voice="using:Chat.UI.Voice"
  x:Class="Chat.UI.Voice.VoiceView" x:DataType="vm:ShellViewModel">
  <Grid RowDefinitions="*,Auto" Margin="32,24" MaxWidth="560">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="10">
      <TextBlock Text="{Binding PaneTitle}" FontSize="22" FontWeight="SemiBold" />
      <TextBlock Text="{Binding VoiceStatus}" Classes="muted" TextWrapping="Wrap" />
      <TextBlock Text="{i18n:T InputDevice}" FontSize="13" Margin="0,12,0,0" />
      <ComboBox ItemsSource="{Binding Devices.Inputs}" SelectedItem="{Binding Devices.SelectedInput}"
        HorizontalAlignment="Stretch" MinHeight="40" AutomationProperties.Name="{i18n:T InputDevice}">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="voice:AudioDeviceChoice">
            <TextBlock Text="{Binding Name}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <TextBlock Text="{i18n:T OutputDevice}" FontSize="13" Margin="0,8,0,0" />
      <ComboBox ItemsSource="{Binding Devices.Outputs}" SelectedItem="{Binding Devices.SelectedOutput}"
        HorizontalAlignment="Stretch" MinHeight="40" AutomationProperties.Name="{i18n:T OutputDevice}">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="voice:AudioDeviceChoice">
            <TextBlock Text="{Binding Name}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <TextBlock Text="{Binding Devices.Error}" Classes="muted" TextWrapping="Wrap" IsVisible="{Binding Devices.HasError}" />
      <TextBlock Text="{i18n:T AudioQuality}" FontSize="13" Margin="0,12,0,0" />
      <ComboBox ItemsSource="{Binding AudioQualityChoices}" SelectedItem="{Binding SelectedAudioQuality}"
        HorizontalAlignment="Stretch" MinHeight="40" AutomationProperties.Name="{i18n:T AudioQuality}">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="vm:AudioQualityChoice">
            <StackPanel Spacing="2" Margin="0,2">
              <TextBlock Text="{Binding Title}" />
              <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="12" />
            </StackPanel>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <StackPanel Spacing="8" IsVisible="{Binding CanSetChannelQuality}">
        <TextBlock Text="{i18n:T ChannelQualityCap}" FontSize="13" Margin="0,8,0,0" />
        <ComboBox ItemsSource="{Binding ChannelQualityChoices}" SelectedItem="{Binding SelectedChannelQuality}"
          HorizontalAlignment="Stretch" MinHeight="40" AutomationProperties.Name="{i18n:T ChannelQualityCap}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:AudioQualityChoice">
              <StackPanel Spacing="2" Margin="0,2">
                <TextBlock Text="{Binding Title}" />
                <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="12" />
              </StackPanel>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </StackPanel>
      <ItemsControl ItemsSource="{Binding VoiceMembers}" Margin="0,12,0,0">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding}" Margin="0,4" FontSize="16" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10" Margin="0,24,0,0">
      <Button Content="{Binding MuteLabel}" Command="{Binding ToggleMute}" Background="{StaticResource RaisedBrush}" Padding="16,10" />
      <Button Content="{Binding DeafLabel}" Command="{Binding ToggleDeaf}" Background="{StaticResource RaisedBrush}" Padding="16,10" />
      <Button Content="{i18n:T LeaveVoice}" Command="{Binding LeaveVoice}" Background="{StaticResource RaisedBrush}" Padding="16,10" />
    </StackPanel>
  </Grid>
</UserControl>
