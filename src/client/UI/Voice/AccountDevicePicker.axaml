<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Chat.UI.Voice"
 x:Class="Chat.UI.Voice.AccountDevicePicker" x:Name="Root" x:DataType="vm:AccountDevicePicker" Width="240">
  <UserControl.Styles>
    <Style Selector="ListBox"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="0" /></Style>
    <Style Selector="ListBoxItem"><Setter Property="MinHeight" Value="32" /><Setter Property="Padding" Value="8,6" /><Setter Property="CornerRadius" Value="2" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource SubtleBrush}" /></Style>
    <Style Selector="TextBlock.deviceCheck"><Setter Property="Opacity" Value="0" /></Style>
    <Style Selector="ListBoxItem:selected TextBlock.deviceCheck"><Setter Property="Opacity" Value="1" /></Style>
  </UserControl.Styles>
  <StackPanel Spacing="4">
    <TextBlock Text="{Binding Title, ElementName=Root}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="8,4,8,5" />
    <ListBox x:Name="DeviceList" ItemsSource="{Binding Choices, ElementName=Root}"
      SelectedItem="{Binding SelectedDevice, ElementName=Root, Mode=TwoWay}" MaxHeight="224"
      AutomationProperties.Name="{Binding Title, ElementName=Root}" PointerReleased="OnChoose" KeyDown="OnKeyDown">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:AudioDeviceChoice">
          <Grid ColumnDefinitions="*,16" ColumnSpacing="8">
            <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
            <TextBlock Grid.Column="1" Classes="deviceCheck" Text="✓" FontSize="12" HorizontalAlignment="Center" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <TextBlock Text="{Binding Error, ElementName=Root}" IsVisible="{Binding HasError, ElementName=Root}" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}" FontSize="12" Margin="8,4" />
  </StackPanel>
</UserControl>
